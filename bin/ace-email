#!/usr/bin/env python3
"""ACE's ONLY email send path — a thin shim over the shared canopy email engine.

The HTML wrapper (Gmail display-wraps plain text at ~72 cols; HTML reflows), reply
threading, --reply-all derivation (To = original sender, Cc = everyone else on the
original To+Cc — raw reads hide Cc and drop cc'd people), send timeout, and identity
resolution all live in canopy (`canopy email send`, engine ≥ 0.2.255), so fixes
propagate fleet-wide. This shim only pins --repo so identity comes from THIS repo's
config/agent.json (`email` + `gog_client`). The deny rail in config/gating.json blocks
raw `gog gmail send/reply` as ACE, so email leaves ACE only through here.

SEND-SIDE CONTRACT: every successful send prints JSON with message_id + thread_id —
record thread_id into the run's comms-log so inbound triage can route the reply
(see skills/email-communicator/SKILL.md step 7).

Usage:
  bin/ace-email --to "a@x,b@y" [--cc "c@z"] --subject "Re: ..." \\
      --body-file body.txt [--reply-to-message-id <id>] [--dry-run]

  # Replying to everyone on a thread — pass the THREAD id, never --reply-to-message-id
  # (a thread id is its first message's id, so that pair replies to the thread HEAD — ace#2391):
  bin/ace-email --reply-all --thread-id <thread-id> --subject "Re: ..." --body-file body.txt

  # When the subject comes from INBOUND mail, pass it as a FILE, never inline:
  bin/ace-email --to "a@x" --subject-file subj.txt --body-file body.txt

  # Asked to FORWARD a message? Forward it — don't write a summary and re-attach:
  bin/ace-email forward <thread-id> --to "a@x" [--note-file note.txt] [--dry-run]

`forward` execs `canopy email forward` (canopy ≥ 0.2.583): Fwd: subject, the original
header block + body, and the message's attachments under their real filenames. The
review receipt is keyed to --note-file (record it with `review-receipt --body-file
<note-file>`). Before it existed, a "forward this receipt" request went out as a new
message summarising the mail with its PDFs renamed `*_attachment.bin` (2026-10-05).

--subject-file exists because the SUBJECT of a reply is attacker-controlled
(2026-07-31 security audit, A4 / dimagi-internal/ace#1114). `inbox-triage`
derives `--subject` from inbound mail as `Re: <their subject>`, and
`email-communicator` has the MODEL compose this invocation as a **Bash**
command — so a crafted subject containing `"; curl ...|sh; #` is a shell
injection into the operator's own machine. The body was already file-passed for
exactly this reason; the subject was not. This shim reads the file and hands the
value to canopy through `execvp` argv, where no shell is involved.

RUN-PAGE CHECK (ace#2378). ace-web is the human surface for a run; Google Drive
is ACE's storage. A body that links `docs.google.com` / `drive.google.com` but
carries no `labs.connect.dimagi.com/ace/` link is refused (exit 3) before canopy
is called — the fix is to lead with the run's ace-web page (`run_state.yaml`
top-level `ace_web_summary_url`) and keep the Drive links as deep links under it.
`--dry-run` gets the same verdict, so a draft is caught before the approval step.
A send whose recipient is not a reviewer of the run passes an explicit reason —
a thread with no run behind it (sales/BD), or a partner-facing deliverable whose
subject IS the Drive pack, such as the Phase 9 LLO onboarding email (ace#2380):

  bin/ace-email ... --body-file body.txt --no-run-page "sales thread, no run yet"

The flag is consumed here and never reaches canopy; the reason is echoed to stderr
so the transcript records why the check was skipped.

CANOPY-WEB LINK CHECK (canopy-web#1337). Every canopy-web link in the body must be
workspace-addressed (`https://canopy.dimagi.com/w/<workspace>/…`). A flat
`/review/<id>`, `/walkthrough/<id>`, `/ddd/<slug>`, `/share/<token>` or legacy
`/w/<uuid>` is refused (exit 3), dry-run included; there is no override, because the
scoped form always exists. Rule lives in bin/canopy_url_scope.py.

Auth check: `canopy email preflight --repo <this repo>` (exact `gog login` fix on failure).
"""
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

sys.path.insert(0, os.path.join(REPO, "hooks"))
import tenancy_guard as _tg  # noqa: E402


def _load_keyring_env():
    """Put gog's file-keyring credentials in this process's env before exec'ing
    canopy, which shells out to gog.

    Without this, SEND is dead in any session a canopy runner spawns: the
    password lives in the plugin-data `.env` and in no shell profile, so gog
    cannot open its keyring and fails with `no TTY available for keyring file
    backend password prompt`. An existing value always wins. Same pair, same
    order, as bin/ace-env — see its header for the routes that do NOT work (the
    runner LaunchAgent plist reaches the daemon only). ace#2844."""
    for key in ("GOG_KEYRING_PASSWORD", "GOG_KEYRING_BACKEND"):
        if not os.environ.get(key):
            value = _tg.plugin_env(key)
            if value:
                os.environ[key] = value


def _exec_via_canopy_runtime(args):
    """Fallback when `canopy` isn't on PATH: run the engine via uv from canopy's
    installed-plugin runtime (resolved by canopy's own scripts/canopy-runtime.sh).
    Returns (falls through) on any failure so the caller can print the final error."""
    try:
        if shutil.which("uv") is None:
            return
        registry = os.path.expanduser("~/.claude/plugins/installed_plugins.json")
        with open(registry) as f:
            install_path = json.load(f)["plugins"]["canopy@canopy"][0]["installPath"]
        resolver = os.path.join(install_path, "scripts", "canopy-runtime.sh")
        if not os.path.isfile(resolver):
            return
        proc = subprocess.run(
            ["bash", resolver], capture_output=True, text=True, timeout=60
        )
        runtime_root = proc.stdout.strip()
        if proc.returncode != 0 or not runtime_root:
            return
        os.execvp("uv", ["uv", "run", "--project", runtime_root, "canopy", *args])
    except Exception:
        return


def _resolve_subject_file(argv):
    """Translate `--subject-file PATH` into `--subject <contents>`.

    canopy's engine takes `--subject TEXT` only, and adding a file form
    upstream would not help the injection this closes: the danger is the Bash
    command line the MODEL writes, which is upstream of both. Reading it here
    means the untrusted bytes never appear in a shell command — `execvp` below
    takes an argv LIST, so nothing re-parses them.
    """
    out = []
    i = 0
    while i < len(argv):
        if argv[i] == "--subject-file":
            if i + 1 >= len(argv):
                sys.exit("--subject-file needs a path")
            try:
                with open(argv[i + 1], encoding="utf-8") as f:
                    subject = f.read().strip()
            except OSError as e:
                sys.exit(f"--subject-file: cannot read {argv[i + 1]}: {e}")
            if not subject:
                sys.exit(f"--subject-file: {argv[i + 1]} is empty")
            # Subjects are a single header line; a newline would let an
            # attacker inject additional headers.
            subject = subject.splitlines()[0]
            out += ["--subject", subject]
            i += 2
            continue
        out.append(argv[i])
        i += 1
    return out


ACE_WEB_MARKER = "labs.connect.dimagi.com/ace/"
DRIVE_LINK = re.compile(r"(?:https?://)?(?:docs|drive)\.google\.com/\S*", re.IGNORECASE)
RUN_PAGE_OVERRIDE = "--no-run-page"
REFUSED_EXIT = 3


def _take_run_page_override(argv):
    """Strip `--no-run-page REASON` (or `=REASON`) out of argv; canopy never sees it."""
    out, reason = [], None
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == RUN_PAGE_OVERRIDE or arg.startswith(RUN_PAGE_OVERRIDE + "="):
            if "=" in arg:
                value = arg.split("=", 1)[1]
                i += 1
            elif i + 1 < len(argv):
                value = argv[i + 1]
                i += 2
            else:
                value = ""
                i += 1
            if not value.strip():
                sys.exit(
                    f'{RUN_PAGE_OVERRIDE} needs a reason, e.g. {RUN_PAGE_OVERRIDE} "sales thread, no run yet"'
                )
            reason = value.strip()
            continue
        out.append(arg)
        i += 1
    return out, reason


def _body_file(argv):
    """The file holding ACE's own prose: --body-file on a send, --note-file on a forward."""
    for flag in ("--body-file", "--note-file"):
        for i, arg in enumerate(argv):
            if arg == flag and i + 1 < len(argv):
                return argv[i + 1]
            if arg.startswith(flag + "="):
                return arg.split("=", 1)[1]
    return None


def _check_run_page(argv, override_reason):
    """Refuse a Drive-linked body that never names the run's ace-web page (ace#2378)."""
    if override_reason is not None:
        print(f"ace-email: run-page check overridden — {override_reason}", file=sys.stderr)
        return
    path = _body_file(argv)
    if path is None:
        return  # --body-file is required; canopy reports its absence
    if path == "-" or path.startswith("/dev/"):
        sys.exit(
            "ace-email checks the body before it sends, so it needs a real file — "
            "write the body to a file and pass --body-file <path>"
        )
    try:
        with open(path, encoding="utf-8") as f:
            body = f.read()
    except OSError:
        return  # unreadable: canopy owns --body-file validation and will refuse it
    drive_links = DRIVE_LINK.findall(body)
    if not drive_links or ACE_WEB_MARKER in body.lower():
        return
    dry = " (dry-run — a real send gets this same refusal)" if "--dry-run" in argv else ""
    shown = "\n".join(f"  {u}" for u in drive_links[:3])
    print(
        f"ace-email: REFUSED{dry}. The body links Google Drive/Docs but not the run's ace-web page.\n"
        "ace-web is the human surface for a run; Drive is ACE's storage "
        "(CLAUDE.md § Conventions, ace#2378).\n"
        "Fix: lead with the run's page — run_state.yaml `ace_web_summary_url`, e.g.\n"
        "  https://labs.connect.dimagi.com/ace/opps/dimagi-team/<opp>/runs/<run-id>/summary\n"
        "and keep the Drive links as deep links under it.\n"
        "Not a reviewer-facing reference to a run — a sales/BD thread with no run, or a\n"
        "partner-facing deliverable such as the Phase 9 LLO onboarding pack? Re-run with\n"
        f'{RUN_PAGE_OVERRIDE} "<why>".\n'
        f"Drive links found:\n{shown}",
        file=sys.stderr,
    )
    sys.exit(REFUSED_EXIT)


def _check_canopy_urls(argv):
    """Refuse a body carrying a canopy-web link that is not workspace-addressed.

    canopy-web addresses every artifact as /w/<workspace>/…; flat /review/<id>,
    /walkthrough/<id>, /ddd/<slug>, /share/<token> and the legacy /w/<uuid> only worked
    through redirects canopy-web is removing (canopy-web#1337). No override: the scoped
    form always exists, so the fix is to use it.
    """
    path = _body_file(argv)
    if path is None or path == "-" or path.startswith("/dev/"):
        return  # _check_run_page already refuses non-file bodies
    try:
        with open(path, encoding="utf-8") as f:
            body = f.read()
    except OSError:
        return
    sys.path.insert(0, os.path.join(REPO, "bin"))
    from canopy_url_scope import flat_urls  # noqa: E402

    flat = flat_urls(body)
    if not flat:
        return
    dry = " (dry-run — a real send gets this same refusal)" if "--dry-run" in argv else ""
    shown = "\n".join(f"  {u}" for u in flat[:5])
    print(
        f"ace-email: REFUSED{dry}. The body has canopy-web links that are not workspace-addressed.\n"
        "Every canopy-web link must be https://canopy.dimagi.com/w/<workspace>/… — e.g.\n"
        "  https://canopy.dimagi.com/w/connect/review/<id>?t=<token>\n"
        "  https://canopy.dimagi.com/w/connect/walkthrough/<id>?t=<token>\n"
        "  https://canopy.dimagi.com/w/connect/ddd/<narrative>\n"
        "Flat links depend on redirects canopy-web is removing (canopy-web#1337). "
        "bin/ace-canopy-web prints the scoped form.\n"
        f"Flat links found:\n{shown}",
        file=sys.stderr,
    )
    sys.exit(REFUSED_EXIT)


def _check_labs_workflow_urls(argv):
    """Refuse a body whose labs workflow links are not run deep-links (ace#3418).

    A bare `/labs/workflow/<def>/run/` resolves against the READER's currently-selected
    opportunity, so it lands them on the workflow list — "No Workflows Found" — while
    looking correct to the sender. No override: the deep-link form always exists
    (`workflow_history_runs` gives the run_id), so the fix is to use it.
    """
    path = _body_file(argv)
    if path is None or path == "-" or path.startswith("/dev/"):
        return  # _check_run_page already refuses non-file bodies
    try:
        with open(path, encoding="utf-8") as f:
            body = f.read()
    except OSError:
        return
    sys.path.insert(0, os.path.join(REPO, "bin"))
    from labs_workflow_url import bare_workflow_urls  # noqa: E402

    bare = bare_workflow_urls(body)
    if not bare:
        return
    dry = " (dry-run — a real send gets this same refusal)" if "--dry-run" in argv else ""
    shown = "\n".join(f"  {u}\n    → {why}" for u, why in bare[:5])
    print(
        f"ace-email: REFUSED{dry}. The body has labs workflow links that will not open "
        "their dashboard.\n"
        "A bare link resolves against whatever opportunity the READER has selected, so they\n"
        "get the workflow list — 'No Workflows Found' — while it looks right to you.\n"
        "Use the run deep-link:\n"
        "  https://labs.connect.dimagi.com/labs/workflow/<def>/run/?run_id=<run>&opportunity_id=<opp>\n"
        "  (program-owned dashboards take &program_id=<prog> instead)\n"
        "`workflow_history_runs(definition_id, opportunity_id)` gives the run_id. Open each\n"
        "link before you send it: a 200 is not evidence — a wrong run_id still returns 200\n"
        "with an empty shell.\n"
        f"Links found:\n{shown}",
        file=sys.stderr,
    )
    sys.exit(REFUSED_EXIT)


def _recipients_from_argv(argv):
    """Every address this send will reach, from --to/--cc/--bcc (repeatable, = or space)."""
    out = []
    for i, arg in enumerate(argv):
        for flag in ("--to", "--cc", "--bcc"):
            if arg == flag and i + 1 < len(argv):
                out.append(argv[i + 1])
            elif arg.startswith(flag + "="):
                out.append(arg.split("=", 1)[1])
    return out


def _check_links_verified(argv):
    """Refuse a body whose links to OUR OWN surfaces have not been opened (ace#3426).

    The contract is skills/_verify-before-send.md. A 200 is not evidence — a wrong-id Labs
    dashboard returns 200 with the right title and no data — so the receipt records a
    caller-declared string that proves the content rendered, and the recipients it was
    checked for. No override: a link you could not open is a link you may not send.
    """
    path = _body_file(argv)
    if path is None or path == "-" or path.startswith("/dev/"):
        return  # _check_run_page already refuses non-file bodies
    try:
        with open(path, encoding="utf-8") as f:
            body = f.read()
    except OSError:
        return
    sys.path.insert(0, os.path.join(REPO, "bin"))
    from link_verification import missing_coverage  # noqa: E402

    # --reply-all derives recipients inside canopy, so they are not in argv. Anything the
    # receipt covers is fine; what we can check here is that a receipt exists and passed.
    why, _receipt = missing_coverage(body, _recipients_from_argv(argv))
    if why is None:
        return
    dry = " (dry-run — a real send gets this same refusal)" if "--dry-run" in argv else ""
    print(
        f"ace-email: REFUSED{dry}. {why}.\n"
        "Nothing goes to a person until you have opened it yourself, as they will open it\n"
        "(skills/_verify-before-send.md). Open every link and record the verdict:\n"
        "  bin/ace-verify-links --body-file <body> \\\n"
        '    --recipients "<every To and Cc address>" \\\n'
        '    --expect "<url>=<string that proves the content rendered>" \\\n'
        '    --access "<host>=<which rule lets each recipient reach it>"\n'
        "A 200 is not evidence: a wrong-id dashboard returns 200 with the right title and no\n"
        "data, which is how four broken links reached a partner four times (ace#3426).\n"
        "Editing the body invalidates the receipt, by design — re-verify after any edit.",
        file=sys.stderr,
    )
    sys.exit(REFUSED_EXIT)


SECRET_VOCABULARY = (
    "client_secret",
    "refresh token",
    "gog login",
    "service-account key",
    "service account key",
    "keyring",
    "oauth token",
    "access token",
    "ACE_WEB_PAT_TOKEN",
    "LABS_MCP_TOKEN",
    "~/.ace/",
    ".env",
)


def _check_no_internal_plumbing(argv):
    """Refuse a body that narrates ACE's own credentials or runner setup (ace#3426).

    canopy's agent-core/turn.md Step 1: "Never tell a counterpart about logins, credentials
    or runner setup." A broken credential is ours to fix and to state as a fault — "the page
    is broken at our end, I have no date yet" is the whole of what they need. The rule
    existed in prose; the leak happens on the send path, so the check lives here.
    """
    path = _body_file(argv)
    if path is None or path == "-" or path.startswith("/dev/"):
        return
    try:
        with open(path, encoding="utf-8") as f:
            body = f.read()
    except OSError:
        return
    low = body.lower()
    hits = [t for t in SECRET_VOCABULARY if t.lower() in low]
    if not hits:
        return
    dry = " (dry-run — a real send gets this same refusal)" if "--dry-run" in argv else ""
    print(
        f"ace-email: REFUSED{dry}. The body narrates ACE's own plumbing: "
        + ", ".join(repr(h) for h in hits)
        + ".\n"
        "Logins, tokens, keyrings, runner setup and .env are never a counterpart's business\n"
        "(canopy agent-core/turn.md Step 1; skills/_verify-before-send.md § 6).\n"
        "Say what they need instead: what is broken, that it is ours, and whether you have a\n"
        "date — e.g. 'the run page is broken at our end and I have no fix date yet'.",
        file=sys.stderr,
    )
    sys.exit(REFUSED_EXIT)


_ARGV = sys.argv[1:]
VERB = "forward" if _ARGV[:1] == ["forward"] else "send"
if VERB == "forward":
    _ARGV = _ARGV[1:]
ARGS, _OVERRIDE = _take_run_page_override(_resolve_subject_file(_ARGV))
SEND_LEDGER = os.environ.get(
    "ACE_SEND_LEDGER", os.path.expanduser("~/.ace/pending-sends.jsonl")
)


def _record_send_attempt(argv, verb):
    """Log that a send is about to happen, so it cannot be silently lost (ace#3426).

    A send is only half the work: the other half is recording it where the next turn looks
    (the run's comms-log, or the thread's board card). On 2026-11-13 a card still read
    "approve the parked reply" the morning after that reply had gone out, so a turn opened
    on stale instructions and nearly re-sent it.

    This runs immediately BEFORE exec, after every rail, and never on --dry-run: the shim
    hands the process to canopy, so there is no after. `bin/ace-pending-sends` lists what
    has not been acknowledged; `--ack` clears one once it is recorded.
    """
    if "--dry-run" in argv:
        return
    path = _body_file(argv)
    fingerprint = ""
    if path and path != "-" and not path.startswith("/dev/"):
        try:
            with open(path, encoding="utf-8") as f:
                fingerprint = hashlib.sha256(f.read().encode("utf-8")).hexdigest()[:16]
        except OSError:
            pass
    thread = ""
    for i, arg in enumerate(argv):
        if arg == "--thread-id" and i + 1 < len(argv):
            thread = argv[i + 1]
        elif arg.startswith("--thread-id="):
            thread = arg.split("=", 1)[1]
    record = {
        "at": time.time(),
        "verb": verb,
        "thread_id": thread,
        "recipients": _recipients_from_argv(argv),
        "body_fingerprint": fingerprint,
        "acknowledged": False,
    }
    try:
        os.makedirs(os.path.dirname(SEND_LEDGER), exist_ok=True)
        with open(SEND_LEDGER, "a", encoding="utf-8") as f:
            f.write(json.dumps(record, sort_keys=True) + "\n")
    except OSError:
        pass  # the ledger is bookkeeping; never block a reviewed send on it


_check_run_page(ARGS, _OVERRIDE)
_check_canopy_urls(ARGS)
_check_labs_workflow_urls(ARGS)
_check_no_internal_plumbing(ARGS)
_check_links_verified(ARGS)
_record_send_attempt(ARGS, VERB)

_load_keyring_env()

try:
    os.execvp("canopy", ["canopy", "email", VERB, "--repo", REPO, *ARGS])
except FileNotFoundError:
    _exec_via_canopy_runtime(["email", VERB, "--repo", REPO, *ARGS])
    sys.exit(
        "canopy CLI not on PATH — the shared email engine lives there (canopy ≥ 0.2.255).\n"
        "Install it (`uv tool install canopy` from the canopy checkout) or run "
        "`uv run canopy email send --repo <this repo> ...` from a canopy checkout.\n"
        "See /canopy:setup."
    )
