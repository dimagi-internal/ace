#!/usr/bin/env python3
"""ACE's ONLY email send path — a thin shim over the shared canopy email engine.

The HTML wrapper (Gmail display-wraps plain text at ~72 cols; HTML reflows), reply
threading, --reply-all derivation (To = original sender, Cc = everyone else on the
original To+Cc — raw reads hide Cc and drop cc'd people), send timeout, and identity
resolution all live in canopy (`canopy email send`, engine ≥ 0.2.255), so fixes
propagate fleet-wide. This shim only pins --repo so identity comes from THIS repo's
config/agent.json (`email` + `gog_client`). The deny rail in config/gating.json blocks
raw `gog gmail send/reply` as ACE, so email leaves ACE only through here.

SEND-SIDE CONTRACT: every successful send prints JSON with message_id + thread_id —
record thread_id into the run's comms-log so inbound triage can route the reply
(see skills/email-communicator/SKILL.md step 7).

Usage:
  bin/ace-email --to "a@x,b@y" [--cc "c@z"] --subject "Re: ..." \\
      --body-file body.txt [--reply-to-message-id <id>] [--reply-all] [--dry-run]

  # When the subject comes from INBOUND mail, pass it as a FILE, never inline:
  bin/ace-email --to "a@x" --subject-file subj.txt --body-file body.txt

--subject-file exists because the SUBJECT of a reply is attacker-controlled
(2026-07-31 security audit, A4 / dimagi-internal/ace#1114). `inbox-triage`
derives `--subject` from inbound mail as `Re: <their subject>`, and
`email-communicator` has the MODEL compose this invocation as a **Bash**
command — so a crafted subject containing `"; curl ...|sh; #` is a shell
injection into the operator's own machine. The body was already file-passed for
exactly this reason; the subject was not. This shim reads the file and hands the
value to canopy through `execvp` argv, where no shell is involved.

RUN-PAGE CHECK (ace#2378). ace-web is the human surface for a run; Google Drive
is ACE's storage. A body that links `docs.google.com` / `drive.google.com` but
carries no `labs.connect.dimagi.com/ace/` link is refused (exit 3) before canopy
is called — the fix is to lead with the run's ace-web page (`run_state.yaml`
top-level `ace_web_summary_url`) and keep the Drive links as deep links under it.
`--dry-run` gets the same verdict, so a draft is caught before the approval step.
A thread with no run behind it (a sales/BD thread) passes an explicit reason:

  bin/ace-email ... --body-file body.txt --no-run-page "sales thread, no run yet"

The flag is consumed here and never reaches canopy; the reason is echoed to stderr
so the transcript records why the check was skipped.

Auth check: `canopy email preflight --repo <this repo>` (exact `gog login` fix on failure).
"""
import json
import os
import re
import shutil
import subprocess
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def _exec_via_canopy_runtime(args):
    """Fallback when `canopy` isn't on PATH: run the engine via uv from canopy's
    installed-plugin runtime (resolved by canopy's own scripts/canopy-runtime.sh).
    Returns (falls through) on any failure so the caller can print the final error."""
    try:
        if shutil.which("uv") is None:
            return
        registry = os.path.expanduser("~/.claude/plugins/installed_plugins.json")
        with open(registry) as f:
            install_path = json.load(f)["plugins"]["canopy@canopy"][0]["installPath"]
        resolver = os.path.join(install_path, "scripts", "canopy-runtime.sh")
        if not os.path.isfile(resolver):
            return
        proc = subprocess.run(
            ["bash", resolver], capture_output=True, text=True, timeout=60
        )
        runtime_root = proc.stdout.strip()
        if proc.returncode != 0 or not runtime_root:
            return
        os.execvp("uv", ["uv", "run", "--project", runtime_root, "canopy", *args])
    except Exception:
        return


def _resolve_subject_file(argv):
    """Translate `--subject-file PATH` into `--subject <contents>`.

    canopy's engine takes `--subject TEXT` only, and adding a file form
    upstream would not help the injection this closes: the danger is the Bash
    command line the MODEL writes, which is upstream of both. Reading it here
    means the untrusted bytes never appear in a shell command — `execvp` below
    takes an argv LIST, so nothing re-parses them.
    """
    out = []
    i = 0
    while i < len(argv):
        if argv[i] == "--subject-file":
            if i + 1 >= len(argv):
                sys.exit("--subject-file needs a path")
            try:
                with open(argv[i + 1], encoding="utf-8") as f:
                    subject = f.read().strip()
            except OSError as e:
                sys.exit(f"--subject-file: cannot read {argv[i + 1]}: {e}")
            if not subject:
                sys.exit(f"--subject-file: {argv[i + 1]} is empty")
            # Subjects are a single header line; a newline would let an
            # attacker inject additional headers.
            subject = subject.splitlines()[0]
            out += ["--subject", subject]
            i += 2
            continue
        out.append(argv[i])
        i += 1
    return out


ACE_WEB_MARKER = "labs.connect.dimagi.com/ace/"
DRIVE_LINK = re.compile(r"(?:https?://)?(?:docs|drive)\.google\.com/\S*", re.IGNORECASE)
RUN_PAGE_OVERRIDE = "--no-run-page"
REFUSED_EXIT = 3


def _take_run_page_override(argv):
    """Strip `--no-run-page REASON` (or `=REASON`) out of argv; canopy never sees it."""
    out, reason = [], None
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == RUN_PAGE_OVERRIDE or arg.startswith(RUN_PAGE_OVERRIDE + "="):
            if "=" in arg:
                value = arg.split("=", 1)[1]
                i += 1
            elif i + 1 < len(argv):
                value = argv[i + 1]
                i += 2
            else:
                value = ""
                i += 1
            if not value.strip():
                sys.exit(
                    f'{RUN_PAGE_OVERRIDE} needs a reason, e.g. {RUN_PAGE_OVERRIDE} "sales thread, no run yet"'
                )
            reason = value.strip()
            continue
        out.append(arg)
        i += 1
    return out, reason


def _body_file(argv):
    for i, arg in enumerate(argv):
        if arg == "--body-file" and i + 1 < len(argv):
            return argv[i + 1]
        if arg.startswith("--body-file="):
            return arg.split("=", 1)[1]
    return None


def _check_run_page(argv, override_reason):
    """Refuse a Drive-linked body that never names the run's ace-web page (ace#2378)."""
    if override_reason is not None:
        print(f"ace-email: run-page check overridden — {override_reason}", file=sys.stderr)
        return
    path = _body_file(argv)
    if path is None:
        return  # --body-file is required; canopy reports its absence
    if path == "-" or path.startswith("/dev/"):
        sys.exit(
            "ace-email checks the body before it sends, so it needs a real file — "
            "write the body to a file and pass --body-file <path>"
        )
    try:
        with open(path, encoding="utf-8") as f:
            body = f.read()
    except OSError:
        return  # unreadable: canopy owns --body-file validation and will refuse it
    drive_links = DRIVE_LINK.findall(body)
    if not drive_links or ACE_WEB_MARKER in body.lower():
        return
    dry = " (dry-run — a real send gets this same refusal)" if "--dry-run" in argv else ""
    shown = "\n".join(f"  {u}" for u in drive_links[:3])
    print(
        f"ace-email: REFUSED{dry}. The body links Google Drive/Docs but not the run's ace-web page.\n"
        "ace-web is the human surface for a run; Drive is ACE's storage "
        "(CLAUDE.md § Conventions, ace#2378).\n"
        "Fix: lead with the run's page — run_state.yaml `ace_web_summary_url`, e.g.\n"
        "  https://labs.connect.dimagi.com/ace/opps/dimagi-team/<opp>/runs/<run-id>/summary\n"
        "and keep the Drive links as deep links under it.\n"
        f'No run behind this thread (e.g. sales/BD)? Re-run with {RUN_PAGE_OVERRIDE} "<why>".\n'
        f"Drive links found:\n{shown}",
        file=sys.stderr,
    )
    sys.exit(REFUSED_EXIT)


ARGS, _OVERRIDE = _take_run_page_override(_resolve_subject_file(sys.argv[1:]))
_check_run_page(ARGS, _OVERRIDE)

try:
    os.execvp("canopy", ["canopy", "email", "send", "--repo", REPO, *ARGS])
except FileNotFoundError:
    _exec_via_canopy_runtime(["email", "send", "--repo", REPO, *ARGS])
    sys.exit(
        "canopy CLI not on PATH — the shared email engine lives there (canopy ≥ 0.2.255).\n"
        "Install it (`uv tool install canopy` from the canopy checkout) or run "
        "`uv run canopy email send --repo <this repo> ...` from a canopy checkout.\n"
        "See /canopy:setup."
    )
