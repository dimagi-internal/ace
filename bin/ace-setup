#!/usr/bin/env bash
# ace-setup — one-shot installer for the ACE plugin.
#
# Order is "cheap pre-flight checks first, slow state changes after,
# verification last", so the user never waits through npm install just
# to find out the instance can't be resolved.
#
# Steps:
#   1. Detect plugin root + data dir
#   2. Verify Node/npm; resolve this install's ACE instance via
#      `canopy agent env --plugin ace --print` (canopy >= 0.2.681)
#   3. bin/ace-install-deps (shared runtime-only store for an installed plugin)
#   4. Fill .env from ACE's Canopy vault via `canopy agent env --plugin ace`
#      (binds the install to one instance; the vault is the ONLY list of ACE's
#      env names — canopy agent-runtime.md § One declaration. No template.)
#   5. Download commcare-cli.jar from dimagi/commcare-core's latest
#      tagged release (skip if cached + not --force-install; WARN if gh
#      missing). Gates Phase 3 app-release-smoke Step 4.5.
#   6. Optionally register the SessionStart auto-update hook
#   7. Run bin/ace-doctor and surface remaining issues
#
# Flags:
#   --auto-update      register SessionStart hook for /ace:update
#   --force-install    re-run npm install even if node_modules is present
#   --force-env        re-fill .env even if it matches the vault
#   --agent <slug>     the ACE instance to bind to, when you can see several
#   --rebind           re-bind this install to a different instance (canopy --force)
#   --skip-env         skip .env injection entirely
#   --skip-doctor      skip the trailing doctor pass
#   --print-root       resolve the plugin root, print it, exit. No side effects.
#
# Env overrides:
#   AGENT_ENV_FILE      a .env canopy already filled from this instance's vault
#                       (`canopy agent prepare --runner` sets it). Used instead of
#                       filling.
#   ACE_PLUGIN_REGISTRY       override ~/.claude/plugins/installed_plugins.json
#
# Exit status: 0 on success, 1 on any FAIL the user must fix.
set +e

# ---- arg parsing
AUTO_UPDATE=0
FORCE_INSTALL=0
FORCE_ENV=0
SKIP_ENV=0
SKIP_DOCTOR=0
NO_SHELL_EDIT=0
PRINT_ROOT=0
BIND_AGENT=""
REBIND=0

while [ $# -gt 0 ]; do
  case "$1" in
    --auto-update)   AUTO_UPDATE=1 ;;
    --force-install) FORCE_INSTALL=1 ;;
    --force-env)     FORCE_ENV=1 ;;
    --skip-env)      SKIP_ENV=1 ;;
    --skip-doctor)   SKIP_DOCTOR=1 ;;
    --no-shell-edit) NO_SHELL_EDIT=1 ;;
    --agent)         BIND_AGENT="${2:-}"; shift ;;
    --agent=*)       BIND_AGENT="${1#--agent=}" ;;
    --rebind)        REBIND=1 ;;
    --print-root)    PRINT_ROOT=1 ;;
    -h|--help)
      sed -n '2,47p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *) echo "ace-setup: unknown arg: $1" >&2; exit 2 ;;
  esac
  shift
done

# ---- helpers
pass() { printf 'PASS %s\n' "$1"; }
warn() { printf 'WARN %s\n' "$1"; [ -n "${2:-}" ] && printf '  fix: %s\n' "$2"; }
fail() { printf 'FAIL %s\n' "$1"; [ -n "${2:-}" ] && printf '  fix: %s\n' "$2"; }

EXIT_CODE=0
mark_fail() { EXIT_CODE=1; }

# ---- plugin root detection
#
# ORDERING (ace#2091). This script writes the INSTALLED plugin's data dir —
# $DATA_DIR/.env, which every MCP subprocess reads once at startup — so the
# root it resolves MUST be the installed plugin. (The env comes from ACE's Canopy vault, but $DATA_DIR still
# follows the root.)
#
# Until this change the walk preferred a `$PWD` ancestor over everything but
# `CLAUDE_PLUGIN_ROOT`. Every ACE worktree on the machine is a valid match,
# including ones parked on months-old branches, so `--force-env` run from a
# worktree silently rewrote the machine's `.env` from THAT branch's declarations.
# Measured 2026-09-06 15:05:30 on the ACE workstation: plugin_root resolved to
# a worktree at 0.13.1173, and the installed `.env` came out with the CommCare
# APK pin one release BEHIND what the installed plugin declared — reverting
# PR #2038 machine-wide, invisibly. `/ace:doctor`'s env_freshness probe
# compares MTIME, not CONTENT, so a stale-content .env passes it clean.
# (No literal version is written here on purpose: a pin-shaped literal in a
# comment is indistinguishable from a real knob to lib/apk-pin-sites.ts.)
#
# New order — installed first, and `$PWD` is NOT a candidate at all:
#   1. $CLAUDE_PLUGIN_ROOT      — the harness told us; believe it
#   2. installed_plugins.json   — authoritative installPath for ace@<any marketplace>
#   3. newest plugin cache dir  — registry missing or unreadable
#   4. $SELF_DIR                — the plugin copy this script lives in
#
# `$PWD` was dropped rather than demoted. `$SELF_DIR` is `dirname($0)/..`, so
# it is ALWAYS a valid ACE root — a `$PWD` tail below it would be unreachable
# dead code pretending to be a safety net. The one thing `$PWD` still earns is
# an INFO line saying which checkout you are sitting in and that it was not
# used. `commands/setup.md` already resolves the SCRIPT through the registry;
# before this change the script threw that away and re-resolved from `$PWD`.
SELF_DIR="$(cd "$(dirname "$0")/.." && pwd)"
# Registry lookup + data-dir naming shared with bin/ace-doctor (any ace@<marketplace>).
. "$SELF_DIR/bin/_ace-plugin-paths.sh"

_is_ace_root() {
  [ -n "${1:-}" ] && [ -f "$1/.claude-plugin/plugin.json" ]
}

# installPath Claude Code recorded for ACE — ace@ace, else any ace@<marketplace>
# (e.g. ace@canopy-agents). Empty when node is
# unavailable, the registry is missing, or the entry is absent — all
# non-fatal; the next candidate takes over.
_registry_install_path() {
  ace_registry_field installPath
}

# Version the registry records for ace@ace. NOT the same thing as the VERSION
# file at that installPath — see CLAUDE.md § "that prints a DIRECTORY NAME,
# which can lie". Used only for reporting and the root banner.
_registry_version() {
  ace_registry_field version
}

_version_at() {
  tr -d '[:space:]' < "$1/VERSION" 2>/dev/null || true
}

# Nearest ACE checkout at or above $PWD, or empty. Never fails.
_pwd_ace_checkout() {
  _D="$PWD"
  while [ "$_D" != "/" ]; do
    if [ -f "$_D/.claude-plugin/plugin.json" ] && grep -q '"name": "ace"' "$_D/.claude-plugin/plugin.json" 2>/dev/null; then
      printf '%s\n' "$_D"; return 0
    fi
    _D="$(dirname "$_D")"
  done
  return 0
}

ROOT=""
ROOT_SOURCE=""

if _is_ace_root "${CLAUDE_PLUGIN_ROOT:-}"; then
  ROOT="$CLAUDE_PLUGIN_ROOT"; ROOT_SOURCE="CLAUDE_PLUGIN_ROOT"
fi
if [ -z "$ROOT" ]; then
  CAND="$(_registry_install_path)"
  if _is_ace_root "$CAND"; then ROOT="$CAND"; ROOT_SOURCE="installed_plugins.json"; fi
fi
if [ -z "$ROOT" ]; then
  CAND="$(ace_newest_cache_root)"
  if _is_ace_root "$CAND"; then ROOT="$CAND"; ROOT_SOURCE="plugin-cache-newest"; fi
fi
if [ -z "$ROOT" ] && _is_ace_root "$SELF_DIR"; then
  ROOT="$SELF_DIR"; ROOT_SOURCE="script-self-dir"
fi

if [ -z "$ROOT" ] || [ ! -f "$ROOT/.claude-plugin/plugin.json" ]; then
  if [ "$PRINT_ROOT" = "1" ]; then
    echo "plugin_root="
    echo "plugin_root_source=none"
    echo "plugin_root_version="
    echo "registry_version=$(_registry_version)"
    exit 1
  fi
  fail "plugin_root: could not locate ACE plugin" "run from an ACE checkout, or after /plugin install ace@ace"
  exit 1
fi

ROOT_VERSION="$(_version_at "$ROOT")"
REG_VERSION="$(_registry_version)"

if [ "$PRINT_ROOT" = "1" ]; then
  # Resolution-only mode: no network, no npm, no writes. This is the
  # seam `test/bin/ace-setup-plugin-root.test.ts` drives, so the ordering above
  # is testable without a canopy session or an npm install.
  echo "plugin_root=$ROOT"
  echo "plugin_root_source=$ROOT_SOURCE"
  echo "plugin_root_version=$ROOT_VERSION"
  echo "registry_version=$REG_VERSION"
  echo "registry_key=$(ace_registry_field key)"
  echo "data_dir=$(ace_data_dir "$ROOT")"
  exit 0
fi

echo "INFO plugin_root=$ROOT (source=$ROOT_SOURCE, version=${ROOT_VERSION:-unknown})"

REG_INSTALL_PATH="$(_registry_install_path)"
if [ -n "$REG_INSTALL_PATH" ] && [ "$ROOT" != "$REG_INSTALL_PATH" ]; then
  printf '\n'
  printf '  !! plugin_root is NOT the installed ACE plugin.\n'
  printf '     resolved:  %s (source=%s, version=%s)\n' "$ROOT" "$ROOT_SOURCE" "${ROOT_VERSION:-unknown}"
  printf '     installed: %s (registry version=%s)\n' "$REG_INSTALL_PATH" "${REG_VERSION:-unknown}"
  printf '     $DATA_DIR below follows this root, not the installed plugin. (ace#2091)\n'
  printf '\n'
elif [ -z "$REG_INSTALL_PATH" ]; then
  printf '\n'
  printf '  !! No installed ACE plugin found in the registry — using %s\n' "$ROOT"
  printf '     version: %s. If that is not what you want: /plugin install ace@ace. (ace#2091)\n' "${ROOT_VERSION:-unknown}"
  printf '\n'
fi

# Informational. Sitting in an ACE checkout that is NOT the resolved root is
# the normal, correct state for a worktree session — say so once, rather than
# silently preferring the checkout the way this script used to.
PWD_CHECKOUT="$(_pwd_ace_checkout)"
if [ -n "$PWD_CHECKOUT" ] && [ "$PWD_CHECKOUT" != "$ROOT" ]; then
  echo "INFO cwd_is_ace_checkout=$PWD_CHECKOUT (version=$(_version_at "$PWD_CHECKOUT")) — NOT used as the plugin root"
fi

# ---- data dir (per-machine, persistent across plugin updates)
# $CLAUDE_PLUGIN_DATA, else the installed entry's plugins/data/<plugin>-<marketplace>
# (ace-ace for ace@ace, ace-canopy-agents for ace@canopy-agents) — the same dir the
# MCP servers derive (lib/plugin-data-dir.ts). See bin/_ace-plugin-paths.sh.
DATA_DIR="$(ace_data_dir "$ROOT")"
mkdir -p "$DATA_DIR"
echo "INFO data_dir=$DATA_DIR"

ENV_OUT="$DATA_DIR/.env"

# KEY= names in FILE, one per line, sorted.
env_keys() {
  grep -E '^[[:space:]]*[A-Z_][A-Z0-9_]*=' "$1" 2>/dev/null | sed -E 's/^[[:space:]]*([A-Z_][A-Z0-9_]*)=.*/\1/' | sort -u
}

# Local-only secrets: keys in $ENV_OUT that the vault fill (VAULT_FILE) does not
# carry (set by an operator or minted on this machine, e.g. ACE_E2E_AUTH_TOKEN,
# the ace-web token), captured before $ENV_OUT is replaced so the new file can
# carry them. Sets LOCAL_SECRETS / LOCAL_SECRET_COUNT.
collect_local_secrets() {
  LOCAL_SECRETS=""
  LOCAL_SECRET_COUNT=0
  if [ -f "$ENV_OUT" ]; then
    EXTRA_KEYS="$(comm -23 <(env_keys "$ENV_OUT") <(env_keys "$1"))"
    # Keys deliberately RETIRED. The preservation above keys off "in .env but
    # not in the vault", which is exactly what a retired key looks like — so
    # without this list, removing a key from the vault would IMMORTALISE its
    # last value in the local-only block instead of removing it. That is the
    # opposite of the intent and is silent.
    #
    # ACE_GMAIL_ACCOUNT / ACE_GMAIL_CLIENT: the gog identity now lives solely
    # in config/agent.json. The vault held gmail_client=ace against
    # agent.json's canopy, and no credentials-ace.json is ever provisioned
    # (ace#1147, #1338).
    RETIRED_KEYS="ACE_GMAIL_ACCOUNT ACE_GMAIL_CLIENT"
    while IFS= read -r key; do
      [ -z "$key" ] && continue
      case " $RETIRED_KEYS " in
        *" $key "*)
          echo "INFO env: dropping retired key $key (now sourced from config/agent.json)"
          continue
          ;;
      esac
      line="$(grep -E "^[[:space:]]*${key}=" "$ENV_OUT" | head -1)"
      if [ -n "$line" ]; then
        LOCAL_SECRETS="${LOCAL_SECRETS}${line}
"
        LOCAL_SECRET_COUNT=$((LOCAL_SECRET_COUNT + 1))
      fi
    done <<EOF_KEYS
$EXTRA_KEYS
EOF_KEYS
  fi
}

# Append the captured local-only block to FILE.
append_local_secrets() {
  [ "${LOCAL_SECRET_COUNT:-0}" -gt 0 ] || return 0
  {
    printf '\n# --- ACE local-only secrets (preserved across vault fills) ---\n'
    printf '# Set by operator, NOT in ACE'"'"'s Canopy vault. Keys here must NOT be vault keys;\n'
    printf '# bin/ace-setup auto-preserves them on re-fill. Edit values directly in this file.\n'
    printf '%s' "$LOCAL_SECRETS"
  } >> "$1"
}

# ace#880 — .env was just rewritten, so ANY MCP subprocess already running is
# holding the previous values: they call dotenvConfig() at import and never
# re-read the file.
env_rewritten_notice() {
  printf '\n'
  printf '  !! RESTART REQUIRED — .env was just rewritten.\n'
  printf '     MCP subprocesses read .env ONLY at startup, and /reload-plugins\n'
  printf '     does NOT respawn them. Quit and reopen Claude Code (Cmd-Q), then\n'
  printf '     re-run /ace:doctor.\n'
  printf '     Order matters: run setup FIRST, restart AFTER — the reverse\n'
  printf '     silently leaves every MCP server on the old values.\n'
  if [ -f "$ROOT/scripts/doctor-env-freshness.ts" ]; then
    ENV_FRESH_NOW="$(cd "$ROOT" && node "$ROOT/node_modules/tsx/dist/cli.mjs" scripts/doctor-env-freshness.ts 2>/dev/null || true)"
    case "$ENV_FRESH_NOW" in
      WARN*) printf '     %s\n' "$(printf '%s' "$ENV_FRESH_NOW" | head -1)" ;;
      *) : ;;
    esac
  fi
  printf '\n'
}

# ---- An env canopy already filled (AGENT_ENV_FILE)
#
# On a cloud runner, `canopy agent prepare --runner` fills the agent's .env
# from its vault itself BEFORE it runs this script, and hands the result over
# as AGENT_ENV_FILE.
# Rendering it a second time here would need `canopy agent env`, which takes a
# PERSON's canopy-web token a runner does not have — so on a runner every
# setup run died at "instance: not signed in to canopy-web" and nothing after
# it (deps, ~/.ace/env.sh, the user-scope nova entry, the ace-web token) ran.
# A supplied file is used only when it is readable and non-empty. Otherwise it
# is ignored, loudly, and setup fills from the vault.
SUPPLIED_ENV=""
if [ -n "${AGENT_ENV_FILE:-}" ] && [ "$SKIP_ENV" != "1" ]; then
  if [ ! -r "$AGENT_ENV_FILE" ]; then
    warn "env: AGENT_ENV_FILE=$AGENT_ENV_FILE is not readable — ignoring it"
  elif [ -z "$(env_keys "$AGENT_ENV_FILE")" ]; then
    warn "env: AGENT_ENV_FILE=$AGENT_ENV_FILE carries no KEY= lines — ignoring it"
  else
    SUPPLIED_ENV="$AGENT_ENV_FILE"
    echo "INFO env: using the .env canopy already filled: $SUPPLIED_ENV (AGENT_ENV_FILE)"
  fi
fi

# Will this run fill $ENV_OUT from the vault (which needs the instance)?
NEED_FILL=0
[ "$SKIP_ENV" != "1" ] && [ -z "$SUPPLIED_ENV" ] && NEED_FILL=1

# =====================================================================
# Phase 1 — Cheap pre-flight checks (fast fail)
# =====================================================================

# ---- Node / npm
if command -v node >/dev/null 2>&1; then
  pass "node: $(node --version)"
else
  fail "node: not on PATH" "install Node.js v18+ (https://nodejs.org)"
  exit 1
fi
if command -v npm >/dev/null 2>&1; then
  pass "npm: $(npm --version)"
else
  fail "npm: not on PATH" "install Node.js v18+ (bundles npm)"
  exit 1
fi

# ---- ACE instance (canopy#899)
#
# A plugin is code; an INSTANCE is canopy-web's Agent record (identity,
# workspace, secrets). `canopy agent env` binds this install to ONE instance —
# the only one you can see, the one already bound, or `--agent` — and fills
# .env from that instance's Canopy vault. Resolved here with `--print` (no side
# effects); the env step below calls the same command for real. A failure here
# is recorded, not fatal yet: the stop comes right after the checks below.
CANOPY_MIN="0.2.681"
CANOPY_ERR=""
CANOPY_FIX=""
BOUND_AGENT=""
CANOPY_ARGS=""
[ -n "$BIND_AGENT" ] && CANOPY_ARGS="$CANOPY_ARGS --agent $BIND_AGENT"
[ "$REBIND" = "1" ] && CANOPY_ARGS="$CANOPY_ARGS --force"
if ! command -v canopy >/dev/null 2>&1; then
  CANOPY_ERR="canopy CLI not on PATH"
  CANOPY_FIX="install canopy (its plugin + CLI), then re-run /ace:setup"
else
  CANOPY_VER="$(canopy --version 2>/dev/null | awk '{print $NF}')"
  if [ -z "$CANOPY_VER" ] || [ "$(printf '%s\n%s\n' "$CANOPY_MIN" "$CANOPY_VER" | sort -V | head -1)" != "$CANOPY_MIN" ]; then
    CANOPY_ERR="canopy ${CANOPY_VER:-(unknown version)} is older than $CANOPY_MIN, which added \`canopy agent env\`"
    CANOPY_FIX="run /canopy:update, then re-run /ace:setup"
  else
    _cerr="$(mktemp)"
    # shellcheck disable=SC2086  # CANOPY_ARGS is word-split on purpose (no spaces in slugs)
    BIND_JSON="$(canopy agent env --plugin ace --out "$ENV_OUT" --print $CANOPY_ARGS 2>"$_cerr")"
    _crc=$?
    if [ "$_crc" -eq 0 ]; then
      BOUND_AGENT="$(printf '%s' "$BIND_JSON" | node -e "try{console.log(JSON.parse(require('fs').readFileSync(0,'utf8')).agent||'')}catch(_){}" 2>/dev/null)"
    fi
    if [ -z "$BOUND_AGENT" ]; then
      # Relay canopy verbatim: it names the instances (with re-run lines) or
      # the sign-in step — never guess past it.
      CANOPY_ERR="canopy could not resolve this install's ACE instance. canopy said:
$(cat "$_cerr" 2>/dev/null; [ "$_crc" -eq 0 ] && printf '%s\n' "$BIND_JSON")"
      CANOPY_FIX="several instances → re-run /ace:setup --agent <instance>; bound to another → /ace:setup --rebind --agent <instance>; not signed in → /canopy:setup"
    fi
    rm -f "$_cerr"
  fi
fi
[ -n "$BOUND_AGENT" ] && echo "INFO instance=$BOUND_AGENT (canopy agent env --print)"
# The instance is needed to FILL $ENV_OUT (`canopy agent env` binds it). Stop
# only when this run needs it.
if [ -z "$CANOPY_ERR" ]; then
  pass "instance: $BOUND_AGENT (Canopy vault, from canopy agent env)"
elif [ "$NEED_FILL" = "1" ] && { [ "$FORCE_ENV" = "1" ] || [ ! -f "$ENV_OUT" ]; }; then
  fail "instance: $CANOPY_ERR" "$CANOPY_FIX"
  exit 1
else
  warn "instance: not resolved — not needed this run (an existing .env is kept)" \
       "$(printf '%s' "$CANOPY_ERR" | tail -n +2 | head -3 | tr '\n' ' ')"
  NEED_FILL=0
fi

# =====================================================================
# Phase 2 — Slow state changes (only run if pre-flight passed)
# =====================================================================

# ---- npm install (only after pre-flight passed)
cd "$ROOT" || { fail "cd $ROOT failed"; exit 1; }
# An installed plugin links a shared, runtime-only store; a dev checkout gets a plain
# `npm install`. Cheap when nothing changed, so it always runs (bin/ace-install-deps).
_deps_args=()
[ "$FORCE_INSTALL" = "1" ] && _deps_args=(--force)
if ! "$ROOT/bin/ace-install-deps" ${_deps_args[@]+"${_deps_args[@]}"} "$ROOT"; then
  fail "deps: bin/ace-install-deps failed" "investigate its output above"
  mark_fail
fi
if [ -x node_modules/.bin/tsx ]; then
  pass "deps: tsx=$(node_modules/.bin/tsx --version 2>&1 | head -1)"
fi

# ---- .env from ACE's Canopy vault
#
# The vault on canopy-web is the ONLY declaration of ACE's env names (canopy
# agent-runtime.md § One declaration); there is no template. `canopy agent env
# --plugin ace` fills a scratch file from it (decrypted on this device), which
# is compared with $ENV_OUT: an unchanged vault rewrites nothing, so MCP
# subprocesses are not needlessly staled. Keys $ENV_OUT holds that the vault
# does not are this machine's local-only secrets and are carried across.
if [ "$SKIP_ENV" = "1" ]; then
  warn "env: skipped (--skip-env)" "re-run without --skip-env to populate $ENV_OUT"
elif [ -n "$SUPPLIED_ENV" ]; then
  # canopy filled it from this instance's vault already (AGENT_ENV_FILE, see
  # above): copy it in, keeping this machine's local-only block, atomically.
  collect_local_secrets "$SUPPLIED_ENV"
  SYNC_TMP="$(mktemp "${ENV_OUT}.XXXXXX")"
  cat "$SUPPLIED_ENV" > "$SYNC_TMP"
  append_local_secrets "$SYNC_TMP"
  chmod 600 "$SYNC_TMP"
  if [ -f "$ENV_OUT" ] && cmp -s "$SYNC_TMP" "$ENV_OUT"; then
    rm -f "$SYNC_TMP"
    pass "env: $ENV_OUT already matches $SUPPLIED_ENV (filled by canopy)"
  else
    mv "$SYNC_TMP" "$ENV_OUT"
    pass "env: synced $ENV_OUT from $SUPPLIED_ENV (filled by canopy; preserved $LOCAL_SECRET_COUNT local-only secret(s))"
    env_rewritten_notice
  fi
elif [ "$NEED_FILL" != "1" ]; then
  warn "env: kept the existing $ENV_OUT — the instance did not resolve, so it was not re-checked against the vault" "fix the instance (above), then /ace:setup --force-env"
else
  FILL_DIR="$(mktemp -d)"
  # shellcheck disable=SC2086
  FILL_OUT="$(canopy agent env --plugin ace --out "$FILL_DIR/.env" --agent "$BOUND_AGENT" $CANOPY_ARGS 2>&1)"
  FILL_RC=$?
  if [ "$FILL_RC" -ne 0 ] || [ ! -s "$FILL_DIR/.env" ]; then
    fail "env: canopy agent env failed (exit $FILL_RC)" "your existing $ENV_OUT (if any) is UNTOUCHED. canopy said:"
    printf '%s\n' "$FILL_OUT" | sed 's/^/    /'
    mark_fail
  else
    printf '%s\n' "$FILL_OUT" | sed 's/^/  canopy: /'
    # Keep the instance binding beside the real .env so the next run reuses it.
    [ -f "$FILL_DIR/canopy-instance.json" ] && cp "$FILL_DIR/canopy-instance.json" "$DATA_DIR/canopy-instance.json"
    collect_local_secrets "$FILL_DIR/.env"
    NEW_ENV="$(mktemp "${ENV_OUT}.XXXXXX")"
    cat "$FILL_DIR/.env" > "$NEW_ENV"
    append_local_secrets "$NEW_ENV"
    chmod 600 "$NEW_ENV"
    if [ "$FORCE_ENV" != "1" ] && [ -f "$ENV_OUT" ] && cmp -s "$NEW_ENV" "$ENV_OUT"; then
      rm -f "$NEW_ENV"
      pass "env: $ENV_OUT already matches ACE's Canopy vault (use --force-env to rewrite anyway)"
    else
      mv "$NEW_ENV" "$ENV_OUT"
      pass "env: wrote $ENV_OUT from ACE's Canopy vault ($(env_keys "$FILL_DIR/.env" | wc -l | tr -d ' ') vars; preserved $LOCAL_SECRET_COUNT local-only secret(s))"
      env_rewritten_notice
    fi
  fi
  rm -rf "$FILL_DIR"
fi

# ---- Nova PAT wiring: the user-scope `nova` MCP entry, plus ~/.ace/env.sh
#
# Nova plugin v2 (2026-09-27, voidcraft-labs/nova-plugin#64) REMOVED the
# `headersHelper` that used to read NOVA_API_KEY from the Claude Code env.
# The bundled connection is now OAuth-only, and Nova's documented API-key
# path is a USER-SCOPE `nova` MCP entry carrying the Authorization header
# (docs.commcare.app/mcp/api-keys). Claude Code prefers that entry over the
# plugin's connection to the same URL.
#
# So this block now INSTALLS that entry (it used to DELETE it, which since v2
# would silently drop every ACE session onto a human's OAuth token). The
# install is delegated to `scripts/doctor-nova-header.ts --heal`, the same
# code `/ace:doctor` runs, so setup and doctor cannot disagree about it. ACE
# writes a LITERAL Bearer header rather than Nova's `${NOVA_API_KEY}` form:
# the env-expanded form is only as good as the Claude Code process env, and
# that env is exactly what went missing in ace#1629.
#
# ~/.ace/env.sh + the shell-rc source line stay: Bash-invoked scripts and a
# user who prefers Nova's env-expanded entry both still read the key there.
# Marker-fenced shell-rc edits are the standard pattern (conda init, nvm,
# rustup). Idempotent (marker grep), reversible (delete the block).
if [ -f "$ENV_OUT" ]; then
  NOVA_KEY="$(grep -E '^NOVA_API_KEY=' "$ENV_OUT" | head -1 | sed -E 's/^NOVA_API_KEY=//' | sed -E 's/^"(.*)"$/\1/')"
else
  NOVA_KEY=""
fi
if [ -z "$NOVA_KEY" ]; then
  warn "nova_env: NOVA_API_KEY not resolved in $ENV_OUT" \
       "mint a key at https://commcare.app/settings as the ACE Gmail identity, store it as NOVA_API_KEY in ACE's Canopy vault, then re-run /ace:setup --force-env."
else
  ACE_ENV_DIR="$HOME/.ace"
  ACE_ENV_FILE="$ACE_ENV_DIR/env.sh"
  mkdir -p "$ACE_ENV_DIR"
  # Atomic write: temp file + mv so a concurrent shell sourcing env.sh
  # never sees a half-written file.
  ACE_ENV_TMP="$(mktemp "${ACE_ENV_FILE}.XXXXXX")"
  cat > "$ACE_ENV_TMP" <<EOF
# Managed by bin/ace-setup — do not edit by hand.
# Sourced from your shell rc so Bash-invoked ACE scripts (lib/nova-rpc.ts)
# and an env-expanded user-scope nova entry can read NOVA_API_KEY. The
# Claude Code MCP connection itself uses the literal header /ace:setup
# installs. Re-run /ace:setup after rotating the key in the vault.
export NOVA_API_KEY="$NOVA_KEY"
EOF
  chmod 600 "$ACE_ENV_TMP"
  mv "$ACE_ENV_TMP" "$ACE_ENV_FILE"
  pass "nova_env: wrote $ACE_ENV_FILE"

  # ---- Install / re-point the user-scope nova entry (the only API-key path
  # since nova plugin v2). Never removes it.
  NOVA_HDR_TSX="$ROOT/node_modules/tsx/dist/cli.mjs"
  if [ -f "$NOVA_HDR_TSX" ] && [ -f "$ROOT/scripts/doctor-nova-header.ts" ]; then
    NOVA_HDR_OUT="$(cd "$ROOT" && node "$NOVA_HDR_TSX" scripts/doctor-nova-header.ts --format=lines --heal 2>/dev/null || true)"
    case "$NOVA_HDR_OUT" in
      *"healed: true"*|*"INSTALLED automatically"*|*"RE-POINTED"*|*"REWRITTEN"*)
        pass "nova_mcp_entry: user-scope nova entry installed with the configured PAT — Cmd-Q + reopen Claude Code so it binds" ;;
      *PASS*)
        pass "nova_mcp_entry: user-scope nova entry already authenticates with the configured PAT" ;;
      *)
        warn "nova_mcp_entry: could not confirm the user-scope nova entry" \
             "run /ace:doctor and read nova_header_readiness; or by hand: claude mcp add --transport http --scope user nova https://mcp.commcare.app/mcp --header 'Authorization: Bearer <PAT>'" ;;
    esac
  else
    warn "nova_mcp_entry: deps not installed, cannot install the user-scope nova entry" \
         "run /ace:setup again after npm install, or add it by hand (see playbook/integrations/nova-integration.md § Install + auth)"
  fi

  # ---- Auto-append marker-fenced source line to shell rc
  #
  # Picks the right rc file per platform/shell:
  #   - macOS + zsh  → ~/.zshenv  (launchd-spawned GUI Claude Code reads this,
  #                                ~/.zshrc is interactive-only)
  #   - macOS + bash → ~/.bash_profile  (Mac's standard login shell rc)
  #   - Linux + zsh  → ~/.zshrc
  #   - Linux + bash → ~/.bashrc
  #   - other shells → skip with a printed instruction
  #
  # Marker block is idempotent — re-runs find the marker and skip.
  if [ "$NO_SHELL_EDIT" = "1" ]; then
    info_shell_rc_skip_reason="--no-shell-edit passed"
  fi

  RC_FILE=""
  RC_REASON=""
  OS_NAME="$(uname -s 2>/dev/null)"
  SHELL_NAME="$(basename "${SHELL:-/bin/sh}")"
  case "$OS_NAME:$SHELL_NAME" in
    Darwin:zsh)  RC_FILE="$HOME/.zshenv"; RC_REASON="macOS + zsh (launchd-spawned Claude Code reads .zshenv)" ;;
    Darwin:bash) RC_FILE="$HOME/.bash_profile"; RC_REASON="macOS + bash" ;;
    Linux:zsh)   RC_FILE="$HOME/.zshrc";  RC_REASON="Linux + zsh" ;;
    Linux:bash)  RC_FILE="$HOME/.bashrc"; RC_REASON="Linux + bash" ;;
    *)           RC_FILE=""; RC_REASON="unsupported: OS=$OS_NAME SHELL=$SHELL_NAME" ;;
  esac

  MARKER_OPEN="# >>> ACE managed >>>"
  MARKER_CLOSE="# <<< ACE managed <<<"

  if [ "$NO_SHELL_EDIT" = "1" ]; then
    warn "nova_shell_rc: skipped — --no-shell-edit passed" \
         "add manually:  echo 'source ~/.ace/env.sh' >> $RC_FILE  # then restart Claude Code"
  elif [ -z "$RC_FILE" ]; then
    warn "nova_shell_rc: cannot auto-append (${RC_REASON})" \
         "manually add 'source ~/.ace/env.sh' to your shell's startup file, then restart Claude Code"
  elif [ -f "$RC_FILE" ] && grep -qF "$MARKER_OPEN" "$RC_FILE" 2>/dev/null; then
    pass "nova_shell_rc: $RC_FILE already sources ~/.ace/env.sh (marker block present)"
  else
    # Create the file if it doesn't exist (touch is idempotent).
    touch "$RC_FILE"
    # Append marker-fenced block. Leading newline keeps the block visually
    # separated even if the rc file doesn't end in a newline.
    {
      printf '\n%s\n' "$MARKER_OPEN"
      printf '%s\n' "# Sources ACE's NOVA_API_KEY (and any future env exports) so"
      printf '%s\n' "# ACE scripts and Claude Code can read them. Managed by"
      printf '%s\n' "# /ace:setup; remove this block to opt out."
      printf '%s\n' '[ -f "$HOME/.ace/env.sh" ] && source "$HOME/.ace/env.sh"'
      printf '%s\n' "$MARKER_CLOSE"
    } >> "$RC_FILE"
    pass "nova_shell_rc: appended marker block to $RC_FILE ($RC_REASON) — restart Claude Code to pick up NOVA_API_KEY"
  fi
fi

# ---- ace-web: ACE's own token, obtained the way ACE gets into Connect/OCS
#
# ace-web's API accepts only a browser session or a personal token. Its login
# IS the Connect login, and ACE already signs in to Connect automatically as
# ace@dimagi-ai.com — so setup does the same for ace-web and keeps the result
# on this machine only (the local-only block of $ENV_OUT). Nothing is stored in
# the vault and no one clicks through a browser: re-running setup keeps a
# token that still works, or mints a fresh one labelled for this machine and
# revokes this machine's older ones. See scripts/ace-web-bot-token-mint.ts.
if [ "$SKIP_ENV" != "1" ] && [ -f "$ENV_OUT" ]; then
  ACEWEB_TSX="$ROOT/node_modules/tsx/dist/cli.mjs"
  if [ -f "$ACEWEB_TSX" ] && [ -f "$ROOT/scripts/ace-web-bot-token-mint.ts" ]; then
    # The mint drives a headless Chromium. A fresh machine (a cloud runner's
    # first turn) has none, and the mint's WARN was swallowed into a "re-run
    # setup" hint that a turn cannot act on — so the token stayed missing and
    # the first ace-web write needed a hand-run `npx playwright install`.
    # Idempotent: a no-op when the browser is already there.
    (cd "$ROOT" && npx playwright install chromium >/dev/null 2>&1) || true
    ACEWEB_OUT="$(cd "$ROOT" && CLAUDE_PLUGIN_DATA="$DATA_DIR" node "$ACEWEB_TSX" scripts/ace-web-bot-token-mint.ts --ensure 2>/dev/null | grep -E '^(PASS|WARN) ace_web_token' | tail -1)"
    case "$ACEWEB_OUT" in
      PASS*) pass "${ACEWEB_OUT#PASS }" ;;
      WARN*) warn "${ACEWEB_OUT#WARN }" "only ace-web features need it (ace-bind, clone, release, fork-run, invites, videos, transcript upload). If Playwright's Chromium is missing: cd \"$ROOT\" && npx playwright install chromium, then re-run /ace:setup" ;;
      *)     warn "ace_web_token: could not get ACE's ace-web token (no output)" "re-run /ace:setup; if it persists: cd \"$ROOT\" && CLAUDE_PLUGIN_DATA=\"$DATA_DIR\" npx tsx scripts/ace-web-bot-token-mint.ts --ensure" ;;
    esac
  fi
fi

# ---- commcare-cli.jar (Phase 3 install-gate dependency)
#
# `app-release-smoke` Step 4.5 wraps Dimagi's `commcare-cli.jar validate`
# subcommand to catch runtime-install defects (e.g. a deliver_unit
# entity_id bound to a #case/<calculated-field> on a case-create form
# — install-time XPath bind reads null and CommCare rejects the CCZ
# with "A part of your application is invalid"). The jar runs the same
# `ResourceTable.initializeResources` install path the Android device
# runs, so it catches defects every static Phase 3 gate misses.
#
# Dimagi ships `commcare-cli.jar` as a release asset on every CommCare
# release (since `commcare_2.61.5` at least, ~10MB). We fetch the
# **latest tagged release** (including drafts — picks up `commcare_2.63.0`
# today) via `gh release download`, which handles the draft→stable URL
# transition transparently. Cached at `$DATA_DIR/commcare-cli.jar`; sidecar
# `.version` records which release the bytes came from so doctor can
# detect drift.
#
# Skips silently when:
#   - The jar is already cached AND `--force-install` is not set
#   - `gh` is not installed (we surface a WARN with the manual remediation)
# Skips noisily (WARN) when the download fails — `app-release-smoke`
# treats `cli-validator-unavailable` as `[WARN]` (structural Phase 3
# gates still authoritative), so a download miss doesn't break setup.
CCLI_JAR_PATH="$DATA_DIR/commcare-cli.jar"
CCLI_VERSION_PATH="$DATA_DIR/commcare-cli.jar.version"
if [ -f "$CCLI_JAR_PATH" ] && [ "$FORCE_INSTALL" = "0" ]; then
  CCLI_SIZE="$(stat -f %z "$CCLI_JAR_PATH" 2>/dev/null || stat -c %s "$CCLI_JAR_PATH" 2>/dev/null || echo 0)"
  CCLI_CACHED_VER="$(cat "$CCLI_VERSION_PATH" 2>/dev/null || echo unknown)"
  pass "commcare_cli: $CCLI_JAR_PATH present (${CCLI_SIZE} bytes, version=${CCLI_CACHED_VER}) — re-run with --force-install to refresh"
elif ! command -v gh >/dev/null 2>&1; then
  warn "commcare_cli: gh CLI not installed — skipping auto-download of commcare-cli.jar" "install gh (\`brew install gh && gh auth login\`) and re-run /ace:setup, or manually download from https://github.com/dimagi/commcare-core/releases/latest and place at $CCLI_JAR_PATH"
else
  CCLI_TAG="$(gh release list --repo dimagi/commcare-core --limit 1 --json tagName -q '.[0].tagName' 2>/dev/null)"
  if [ -z "$CCLI_TAG" ]; then
    warn "commcare_cli: couldn't list dimagi/commcare-core releases via gh" "check \`gh auth status\` + network; without this, Phase 3 app-release-smoke can't catch runtime-install defects (it falls through to structural-only gates, which is a [WARN] not a [BLOCKER])"
  else
    echo "  fetching commcare-cli.jar from ${CCLI_TAG} (this can take ~15s for the 10MB asset)..."
    # `gh release download` resolves draft asset URLs transparently via
    # the API, so it works for `commcare_2.63.0` (currently draft) the
    # same as for stable releases. --clobber lets --force-install repair
    # corrupt caches.
    if gh release download "$CCLI_TAG" --repo dimagi/commcare-core --pattern 'commcare-cli.jar' --output "$CCLI_JAR_PATH" --clobber 2>&1 | tail -5; then
      CCLI_SIZE="$(stat -f %z "$CCLI_JAR_PATH" 2>/dev/null || stat -c %s "$CCLI_JAR_PATH" 2>/dev/null || echo 0)"
      if [ "$CCLI_SIZE" -lt 1000000 ]; then
        warn "commcare_cli: downloaded jar is suspiciously small (${CCLI_SIZE} bytes)" "expected ~10MB; check network or rerun /ace:setup --force-install"
        rm -f "$CCLI_JAR_PATH" "$CCLI_VERSION_PATH"
      else
        echo "$CCLI_TAG" > "$CCLI_VERSION_PATH"
        pass "commcare_cli: downloaded ${CCLI_TAG} → $CCLI_JAR_PATH (${CCLI_SIZE} bytes)"
      fi
    else
      warn "commcare_cli: download failed for ${CCLI_TAG}" "manually: gh release download ${CCLI_TAG} --repo dimagi/commcare-core --pattern 'commcare-cli.jar' --output $CCLI_JAR_PATH"
    fi
  fi
fi

# ---- GOG CLI (Google services for the ACE Gmail identity)
# email-communicator (Phase 8 LLO invites, training emails) and any Google
# user-identity ops go through the `gog` CLI authenticated as ACE_GMAIL_ACCOUNT.
# Authorize the FULL practical service set in ONE consent so a single stored
# refresh token covers everything ACE might need. GOG auth is PER-MACHINE and
# the login is an interactive browser OAuth flow, so we install the binary here
# but PRINT the exact login command rather than block setup on it (same model
# as /ace:ocs-login and /ace:connect-login). /ace:doctor's gog_auth probe then
# live-checks scope coverage.
GOG_SERVICES="gmail,calendar,drive,docs,slides,sheets,forms"
# Identity comes from config/agent.json, NOT from .env — those keys are retired
# (see RETIRED_KEYS above, ace#1147). Reading .env here would have made this
# block print "re-run /ace:setup --force-env to inject them" forever, a remedy
# that can never work once the vault stops carrying them.
_agent_field() {
  python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get(sys.argv[2],""))' \
    "$ROOT/config/agent.json" "$1" 2>/dev/null
}
GMAIL_ACCT_VAL="$(_agent_field email)"
# The CLIENT is chosen by the one common function (`canopy email client`,
# canopy#748, via bin/ace-gog-client), never read verbatim: `canopy` and
# `canopy-web` are one app, and the right one is whichever this machine holds a
# token under. Falls back to the declared `gog_client` when canopy can't answer.
GMAIL_CLIENT_VAL="$(bash "$ROOT/bin/ace-gog-client" --root "$ROOT" 2>/dev/null)"
if ! command -v gog >/dev/null 2>&1 && command -v brew >/dev/null 2>&1; then
  echo "INFO gog: installing GOG CLI (brew install steipete/tap/gogcli)..."
  brew install steipete/tap/gogcli 2>&1 | tail -3
fi
if ! command -v gog >/dev/null 2>&1; then
  warn "gog: GOG CLI not installed (brew unavailable or install failed)" "install manually: brew install steipete/tap/gogcli — then connect via the canopy-web 'Connect Google mailbox' button (preferred), or at a terminal: gog login ${GMAIL_ACCT_VAL:-<agent.json email>} --client canopy --services $GOG_SERVICES --force-consent"
elif [ -z "$GMAIL_ACCT_VAL" ] || [ -z "$GMAIL_CLIENT_VAL" ]; then
  warn "gog: email not set in $ROOT/config/agent.json (or no gog client resolvable)" "that file is the single source of truth for the gog identity (ace#1147) — set both fields, then authorize gog"
else
  # The printed remedy always offers the canopy-web button first and, for the
  # terminal path, hard-codes `--client canopy` — never $GMAIL_CLIENT_VAL. That
  # variable can legitimately resolve to `canopy-web` (this machine's mailbox
  # was connected via the button), and `gog login --client canopy-web` cannot
  # work from a terminal: canopy-web only mints a token via its own button.
  GOG_LOGIN_CMD="gog login $GMAIL_ACCT_VAL --client canopy --services $GOG_SERVICES --force-consent"
  GOG_LOGIN_HINT_TEXT="connect via the canopy-web 'Connect Google mailbox' button (preferred, self-service), or at a terminal: $GOG_LOGIN_CMD"
  # Either fleet client serves the mailbox — accept whichever holds credentials.
  if ! gog auth status --account "$GMAIL_ACCT_VAL" --client "$GMAIL_CLIENT_VAL" --json 2>/dev/null | grep -q '"credentials_exists": true'; then
    for _fleet_client in canopy canopy-web; do
      [ "$_fleet_client" = "$GMAIL_CLIENT_VAL" ] && continue
      if gog auth status --account "$GMAIL_ACCT_VAL" --client "$_fleet_client" --json 2>/dev/null | grep -q '"credentials_exists": true'; then
        GMAIL_CLIENT_VAL="$_fleet_client"
        break
      fi
    done
  fi
  if gog auth status --account "$GMAIL_ACCT_VAL" --client "$GMAIL_CLIENT_VAL" --json 2>/dev/null | grep -q '"credentials_exists": true'; then
    pass "gog: CLI installed + credentials present for $GMAIL_ACCT_VAL (client=$GMAIL_CLIENT_VAL). If Google ops 403, re-authorize the full scope set — $GOG_LOGIN_HINT_TEXT"
  else
    warn "gog: CLI installed but NOT authorized for $GMAIL_ACCT_VAL — email + Google ops will fail" "$GOG_LOGIN_HINT_TEXT"
  fi
fi

# ---- Auto-update hook (opt-in)
if [ "$AUTO_UPDATE" = "1" ]; then
  HOOK_SCRIPT="$ROOT/bin/ace-update-check"
  if [ ! -x "$HOOK_SCRIPT" ]; then
    warn "auto_update: $HOOK_SCRIPT not executable" "chmod +x $HOOK_SCRIPT"
  else
    SETTINGS="$HOME/.claude/settings.json"
    mkdir -p "$(dirname "$SETTINGS")"
    [ -f "$SETTINGS" ] || echo "{}" > "$SETTINGS"
    HOOK_RESULT="$(python3 - "$SETTINGS" "$HOOK_SCRIPT" <<'PY' 2>&1
import json, sys
path, hook_cmd = sys.argv[1], sys.argv[2]
try:
    with open(path) as f:
        data = json.load(f)
except Exception as e:
    print(f"ERROR: could not parse {path}: {e}")
    sys.exit(1)
hooks = data.setdefault("hooks", {})
session_start = hooks.setdefault("SessionStart", [])
session_start = [h for h in session_start if "ace-update-check" not in json.dumps(h)]
session_start.append({
    "matcher": "*",
    "hooks": [{"type": "command", "command": hook_cmd, "async": True}],
})
hooks["SessionStart"] = session_start
with open(path, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
print("OK")
PY
)"
    if [ "$HOOK_RESULT" = "OK" ]; then
      pass "auto_update: SessionStart hook registered ($HOOK_SCRIPT)"
    else
      warn "auto_update: failed to register hook" "$HOOK_RESULT"
    fi
  fi
fi

# =====================================================================
# Phase 3 — Verification (run doctor)
# =====================================================================
if [ "$SKIP_DOCTOR" = "0" ]; then
  echo ""
  echo "===== /ace:doctor ====="
  if [ -x "$ROOT/bin/ace-doctor" ]; then
    "$ROOT/bin/ace-doctor"
  else
    warn "doctor: $ROOT/bin/ace-doctor not executable, skipping" "chmod +x $ROOT/bin/ace-doctor"
  fi
fi

echo ""
echo "STATUS: COMPLETE"
exit $EXIT_CODE
