#!/usr/bin/env python3
"""ACE's ONLY path for writing to canopy-web DDD — pins WHO writes and WHERE.

Every canopy DDD write (`scripts.ddd.narrative post`, `snippets upload-video`,
`video-engine/render_locally.py` uploads, `canopy:ddd-*` loops) resolves its
identity as CANOPY_WEB_PAT → the cwd's agent `.env` → ~/.claude/canopy/workbench-token,
and its workspace as arg → CANOPY_WEB_WORKSPACE → `.canopy/ddd/config.yaml` → the
ORG DEFAULT. Run from a canopy checkout with neither pinned, an ACE write lands in
the default workspace under whoever owns the workbench token. That is ace#2805: the
chlorine demo narrative (meant for `connect`) was posted AS JONATHAN into `dimagi`,
its 8 cut videos followed it there, and the session reported "connect" without ever
reading it back.

This wrapper makes both explicit and checks them before anything is written:

  bin/ace-canopy-web --workspace <ws> -- <command...>
      Exec <command> with CANOPY_WEB_PAT = ACE's own PAT (from ACE's .env, never the
      workbench token), CANOPY_WEB_WORKSPACE=<ws>, CANOPY_AGENT=ace. Refuses unless
      the PAT authenticates as ace@dimagi-ai.com AND ACE is editor/admin/owner of <ws>
      (an agent must not write into a workspace it cannot edit — Jonathan, 2026-10-08).

  bin/ace-canopy-web --workspace <ws> verify narrative <slug>
  bin/ace-canopy-web --workspace <ws> verify walkthrough <id>
      Read the write back SCOPED to <ws> (/api/w/<ws>/…). Exit 0 only on HTTP 200.
      Never report where something lives without this.

  bin/ace-canopy-web --workspace <ws> check
      Identity + role preflight only.

Env overrides (tests / unusual hosts): ACE_ENV_FILE (path to ACE's .env),
CANOPY_WEB_API_URL (default https://canopy.dimagi.com).
"""
from __future__ import annotations

import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

ACE_IDENTITY = "ace@dimagi-ai.com"
WRITE_ROLES = {"editor", "admin", "owner"}
DEFAULT_API = "https://canopy.dimagi.com"


def die(msg: str, code: int = 2) -> None:
    print(f"ace-canopy-web: {msg}", file=sys.stderr)
    sys.exit(code)


def env_files() -> list[Path]:
    if os.environ.get("ACE_ENV_FILE"):
        return [Path(os.environ["ACE_ENV_FILE"])]
    home = Path.home()
    return [home / ".claude/plugins/data/ace-ace/.env", home / ".ace/.env"]


def ace_pat() -> str:
    # Deliberately NOT the inherited CANOPY_WEB_PAT and NEVER the workbench token:
    # both can belong to a human. ACE's own .env is the only source.
    for f in env_files():
        try:
            for line in f.read_text(encoding="utf-8").splitlines():
                line = line.strip()
                if line.startswith("CANOPY_WEB_PAT="):
                    val = line.split("=", 1)[1].strip().strip("'\"")
                    if val:
                        return val
        except OSError:
            continue
    die("no CANOPY_WEB_PAT in ACE's .env (" + ", ".join(map(str, env_files())) + "). Run /ace:setup.")
    return ""


def api_get(path: str, pat: str) -> tuple[int, object]:
    base = os.environ.get("CANOPY_WEB_API_URL", DEFAULT_API).rstrip("/")
    req = urllib.request.Request(base + path, headers={"Authorization": f"Bearer {pat}", "Accept": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            body = r.read().decode("utf-8")
            return r.status, (json.loads(body) if body else None)
    except urllib.error.HTTPError as e:
        return e.code, None
    except urllib.error.URLError as e:
        die(f"canopy-web unreachable: {e.reason}")
        return 0, None


def preflight(ws: str, pat: str) -> str:
    status, me = api_get("/api/me/", pat)
    email = (me or {}).get("email", "") if isinstance(me, dict) else ""
    if status != 200 or email != ACE_IDENTITY:
        die(f"the PAT in ACE's .env authenticates as {email or f'HTTP {status}'!r}, not {ACE_IDENTITY}.")
    status, members = api_get(f"/api/workspaces/{ws}/members/", pat)
    # A bare list today; tolerate a {"result": [...]} envelope too.
    rows = members if isinstance(members, list) else (members or {}).get("result", []) if isinstance(members, dict) else []
    role = next((m.get("role") for m in rows if m.get("email") == ACE_IDENTITY), None)
    if status != 200 or role not in WRITE_ROLES:
        die(f"ACE is not an editor of workspace {ws!r} (role: {role or 'none'}, HTTP {status}); "
            "refusing to write there. Ask a workspace owner to add ace@dimagi-ai.com.")
    return role


def main(argv: list[str]) -> None:
    if len(argv) < 2 or argv[0] != "--workspace" or not argv[1].strip():
        die("usage: ace-canopy-web --workspace <ws> (-- <command...> | verify narrative|walkthrough <id> | check)")
    ws, rest = argv[1].strip(), argv[2:]
    pat = ace_pat()

    if rest[:1] == ["verify"]:
        if len(rest) != 3 or rest[1] not in ("narrative", "walkthrough"):
            die("usage: ace-canopy-web --workspace <ws> verify narrative <slug> | verify walkthrough <id>")
        kind, ident = rest[1], rest[2]
        path = f"/api/w/{ws}/ddd/narratives/{ident}/" if kind == "narrative" else f"/api/w/{ws}/walkthroughs/{ident}/"
        status, _ = api_get(path, pat)
        if status != 200:
            die(f"{kind} {ident!r} is NOT readable in workspace {ws!r} (HTTP {status}). "
                "It may have landed in another workspace — do not report it as being here.", 1)
        print(json.dumps({"ok": True, "workspace": ws, kind: ident}))
        return

    role = preflight(ws, pat)
    if rest[:1] == ["check"]:
        print(json.dumps({"ok": True, "identity": ACE_IDENTITY, "workspace": ws, "role": role}))
        return
    if rest[:1] == ["--"]:
        rest = rest[1:]
    if not rest:
        die("no command given after --")
    env = dict(os.environ, CANOPY_WEB_PAT=pat, CANOPY_WEB_WORKSPACE=ws, CANOPY_AGENT="ace")
    os.execvpe(rest[0], rest, env)


if __name__ == "__main__":
    main(sys.argv[1:])
