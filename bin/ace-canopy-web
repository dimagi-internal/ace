#!/usr/bin/env python3
"""ACE's ONLY path for writing to canopy-web DDD — pins WHO writes and WHERE.

Every canopy DDD write (`scripts.ddd.narrative post`, `snippets upload-video`,
`video-engine/render_locally.py` uploads, `canopy:ddd-*` loops) takes its workspace
as arg → CANOPY_WEB_WORKSPACE → `.canopy/ddd/config.yaml` → the ORG DEFAULT. With
neither identity nor workspace pinned, an ACE write once landed in the default
workspace under the machine owner's identity. That
is ace#2805: the chlorine demo narrative (meant for `connect`) was posted AS JONATHAN
into `dimagi`, its 8 cut videos followed it there, and the session reported "connect"
without ever reading it back.

This wrapper makes both explicit and checks them before anything is written:

  bin/ace-canopy-web --workspace <ws> -- <command...>
      Exec <command> with CANOPY_WEB_PAT = the token canopy issues for ace
      (`canopy agent token --slug ace`; never an inherited CANOPY_WEB_PAT),
      CANOPY_WEB_WORKSPACE=<ws>, CANOPY_AGENT=ace. Refuses unless whoever that token
      authenticates as is editor/admin/owner of <ws> (an agent must not write into a
      workspace it cannot edit — Jonathan, 2026-10-08). WHO it is is canopy's call: ace in
      a runner turn, the person in their own local turn (Jonathan, 2026-11-06).

  bin/ace-canopy-web --workspace <ws> verify narrative <slug>
  bin/ace-canopy-web --workspace <ws> verify walkthrough <id>
  bin/ace-canopy-web --workspace <ws> verify storyboard <slug>
      Read the write back SCOPED to <ws> (/api/w/<ws>/…). Exit 0 only on HTTP 200.
      Never report where something lives without this. Prints the workspace-addressed
      `url` to cite (https://canopy.dimagi.com/w/<ws>/…).

Output of a wrapped command is streamed with every flat canopy-web link rewritten to
https://canopy.dimagi.com/w/<ws>/… and each rewrite noted on stderr (canopy-web#1337):
only workspace-addressed links may be copied into anything a person reads.

  bin/ace-canopy-web --workspace <ws> check
      Identity + role preflight only.

Identity: canopy decides (canopy agent-core/agent-runtime.md § Session identity); this
wrapper only asks it. Same three outcomes as lib/ace-canopy-pat.ts: exit 0 = the token;
"No such command" (an older canopy) or no canopy CLI = PHASE-1 FALLBACK to the stored
CANOPY_WEB_PAT in ACE's .env; any other non-zero = a FINAL refusal, surfaced, no fallback.

Env overrides (tests / unusual hosts): ACE_CANOPY_BIN (the canopy CLI to ask),
ACE_ENV_FILE (path to ACE's .env, phase-1 fallback only), CANOPY_WEB_API_URL
(default https://canopy.dimagi.com).
"""
from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import threading
import urllib.error
import urllib.request
from pathlib import Path

WRITE_ROLES = {"editor", "admin", "owner"}
DEFAULT_API = "https://canopy.dimagi.com"
SITE = "https://canopy.dimagi.com"  # human-facing links; always /w/<workspace>/…


def die(msg: str, code: int = 2) -> None:
    print(f"ace-canopy-web: {msg}", file=sys.stderr)
    sys.exit(code)


def env_files() -> list[Path]:
    if os.environ.get("ACE_ENV_FILE"):
        return [Path(os.environ["ACE_ENV_FILE"])]
    home = Path.home()
    return [home / ".claude/plugins/data/ace-ace/.env", home / ".ace/.env"]


def canopy_exe() -> str | None:
    if "ACE_CANOPY_BIN" in os.environ:
        exe = os.environ["ACE_CANOPY_BIN"]
        return exe if os.path.isfile(exe) else None
    exe = shutil.which("canopy") or os.path.expanduser("~/.local/bin/canopy")
    return exe if os.path.isfile(exe) else None


def cli_token() -> str | None:
    """canopy's token for ace; None when canopy can't answer (older canopy / no canopy).
    Any other refusal is FINAL: die with canopy's reason, never fall back."""
    exe = canopy_exe()
    if not exe:
        return None
    try:
        p = subprocess.run([exe, "agent", "token", "--slug", "ace"], stdin=subprocess.DEVNULL,
                           capture_output=True, text=True, timeout=30)
    except subprocess.TimeoutExpired:
        die("canopy has no canopy-web identity for ace here: `canopy agent token` timed out after 30s")
        return None
    except OSError:
        return None
    if p.returncode == 0 and p.stdout.strip():
        return p.stdout.strip()
    if "No such command" in p.stderr:
        return None
    last = (p.stderr.strip().splitlines() or [f"exit {p.returncode}, no reason given"])[-1]
    die(f"canopy has no canopy-web identity for ace here: {last} "
        "(see canopy agent-core/agent-runtime.md § Session identity)")
    return None


def ace_pat() -> str:
    """The token this wrapper acts with — canopy's answer, once per process."""
    tok = cli_token()
    if tok:
        return tok
    # PHASE-1 FALLBACK (an older canopy or no canopy CLI; remove with the stored PAT):
    # the stored PAT in ACE's own .env. Deliberately NOT an inherited CANOPY_WEB_PAT and
    # NEVER the workbench-token: both can belong to a human (ace#2805).
    for f in env_files():
        try:
            for line in f.read_text(encoding="utf-8").splitlines():
                line = line.strip()
                if line.startswith("CANOPY_WEB_PAT="):
                    val = line.split("=", 1)[1].strip().strip("'\"")
                    if val:
                        return val
        except OSError:
            continue
    die("canopy cannot issue a canopy-web token here (no canopy CLI, or one older than "
        "`canopy agent token`) and ACE's .env has no stored CANOPY_WEB_PAT to fall back to ("
        + ", ".join(map(str, env_files())) + ").")
    return ""


def api_get(path: str, pat: str) -> tuple[int, object]:
    base = os.environ.get("CANOPY_WEB_API_URL", DEFAULT_API).rstrip("/")
    req = urllib.request.Request(base + path, headers={"Authorization": f"Bearer {pat}", "Accept": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            body = r.read().decode("utf-8")
            return r.status, (json.loads(body) if body else None)
    except urllib.error.HTTPError as e:
        return e.code, None
    except urllib.error.URLError as e:
        die(f"canopy-web unreachable: {e.reason}")
        return 0, None


def preflight(ws: str, pat: str) -> tuple[str, str]:
    """(identity, role). The identity is whoever canopy's token is — never re-decided here."""
    status, me = api_get("/api/me/", pat)
    email = (me or {}).get("email", "") if isinstance(me, dict) else ""
    if status != 200 or not email:
        die(f"the canopy-web token for ace does not authenticate (HTTP {status}); refusing to write.")
    status, members = api_get(f"/api/workspaces/{ws}/members/", pat)
    # A bare list today; tolerate a {"result": [...]} envelope too.
    rows = members if isinstance(members, list) else (members or {}).get("result", []) if isinstance(members, dict) else []
    role = next((m.get("role") for m in rows if m.get("email") == email), None)
    if status != 200 or role not in WRITE_ROLES:
        die(f"{email} is not an editor of workspace {ws!r} (role: {role or 'none'}, HTTP {status}); "
            f"refusing to write there. Ask a workspace owner to add {email}.")
    return email, role


def main(argv: list[str]) -> None:
    if len(argv) < 2 or argv[0] != "--workspace" or not argv[1].strip():
        die("usage: ace-canopy-web --workspace <ws> (-- <command...> | verify narrative|walkthrough|storyboard <id> | check)")
    ws, rest = argv[1].strip(), argv[2:]
    pat = ace_pat()

    if rest[:1] == ["verify"]:
        if len(rest) != 3 or rest[1] not in ("narrative", "walkthrough", "storyboard"):
            die("usage: ace-canopy-web --workspace <ws> verify narrative <slug> | verify walkthrough <id> | verify storyboard <slug>")
        kind, ident = rest[1], rest[2]
        path = {
            "narrative": f"/api/w/{ws}/ddd/narratives/{ident}/",
            "walkthrough": f"/api/w/{ws}/walkthroughs/{ident}/",
            "storyboard": f"/api/w/{ws}/storyboards/{ident}/",
        }[kind]
        status, _ = api_get(path, pat)
        if status != 200:
            die(f"{kind} {ident!r} is NOT readable in workspace {ws!r} (HTTP {status}). "
                "It may have landed in another workspace — do not report it as being here.", 1)
        # The URL to cite is the workspace-addressed one, never a flat /walkthrough/… (canopy-web#1337).
        url = {
            "narrative": f"{SITE}/w/{ws}/ddd/{ident}",
            "walkthrough": f"{SITE}/w/{ws}/walkthrough/{ident}",
            "storyboard": f"{SITE}/w/{ws}/storyboard/{ident}",
        }[kind]
        print(json.dumps({"ok": True, "workspace": ws, kind: ident, "url": url}))
        return

    identity, role = preflight(ws, pat)
    if rest[:1] == ["check"]:
        print(json.dumps({"ok": True, "identity": identity, "workspace": ws, "role": role}))
        return
    if rest[:1] == ["--"]:
        rest = rest[1:]
    if not rest:
        die("no command given after --")
    env = dict(os.environ, CANOPY_WEB_PAT=pat, CANOPY_WEB_WORKSPACE=ws, CANOPY_AGENT="ace")
    sys.exit(run_scoped(rest, env, ws))


def run_scoped(cmd: list[str], env: dict, ws: str) -> int:
    """Run the wrapped command, streaming its output with every flat canopy-web link
    rewritten to /w/<ws>/… (canopy-web#1337). canopy's own tools print flat links
    (`narrative post` printed /review/<id>/ on 2026-10-08 and that link went out in an
    email), so whatever ACE copies from this output is already the scoped form. Each
    rewrite is reported on stderr so the change is never silent."""
    sys.path.insert(0, str(Path(__file__).resolve().parent))
    from canopy_url_scope import scope_urls  # noqa: E402

    try:
        proc = subprocess.Popen(cmd, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                text=True, bufsize=1)
    except FileNotFoundError:
        die(f"command not found: {cmd[0]}", 127)

    def pump(src, dst):
        for line in src:
            new, changes = scope_urls(line, ws)
            dst.write(new)
            dst.flush()
            for old, scoped in changes:
                print(f"ace-canopy-web: rewrote flat link {old} -> {scoped}", file=sys.stderr, flush=True)

    t = threading.Thread(target=pump, args=(proc.stderr, sys.stderr), daemon=True)
    t.start()
    pump(proc.stdout, sys.stdout)
    rc = proc.wait()
    t.join()
    return rc


if __name__ == "__main__":
    main(sys.argv[1:])
