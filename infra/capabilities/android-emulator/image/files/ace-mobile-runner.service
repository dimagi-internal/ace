[Unit]
Description=ACE android-emulator: the AVD for this lease
Documentation=https://github.com/dimagi-internal/ace/tree/main/infra/capabilities/android-emulator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
Environment=ANDROID_SDK_ROOT=/opt/android-sdk
Environment=ANDROID_HOME=/opt/android-sdk
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/opt/android-sdk/platform-tools:/opt/android-sdk/emulator:/opt/android-sdk/cmdline-tools/latest/bin

# NOT enabled at boot. ace-capability-boot.service starts it once, after writing
# the lease's state to /run/ace-mobile/requested-state, which
# ace-emulator-launch reads. (ace-web's image enabled this unit and switched
# states later by restarting it; a lease machine boots exactly one state.)
ExecStart=/usr/local/bin/ace-emulator-launch

# A launch-script crash (qemu died, adb wedge) gets a bounded number of clean
# restarts. After 3 failed starts in 120s the unit stays `failed`, which the
# boot hook reports as ready.json {ok:false, reason:"emulator-boot-failed"}.
# The lease is then released, not repaired: restore, don't adapt.
Restart=on-failure
RestartSec=10
StartLimitBurst=3
StartLimitIntervalSec=120

StandardOutput=append:/var/log/ace-mobile/runner.log
StandardError=append:/var/log/ace-mobile/runner.log

NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
