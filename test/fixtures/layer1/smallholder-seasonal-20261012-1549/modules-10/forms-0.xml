<?xml version="1.0"?>
<!-- Shaped on smallholder-seasonal/20261012-1549's released Deliver app (HQ 6137de98 v23),
     modules-10/forms-0.xml "Farm plan", from the ace#2883 grep evidence:
       nodeset="/data/__nova_operations/update_participant_plan/case/@case_id"
     Field content is reduced; the case-block placement is the point. -->
<h:html xmlns:h="http://www.w3.org/1999/xhtml" xmlns:orx="http://openrosa.org/jr/xforms" xmlns="http://www.w3.org/2002/xforms" xmlns:jr="http://openrosa.org/javarosa">
  <h:head>
    <h:title>Farm plan</h:title>
    <model>
      <instance>
        <data xmlns="http://openrosa.org/formdesigner/a1" uiVersion="1" version="23" name="Farm plan">
          <plan>
            <main_crop/>
            <planted_area_acres/>
          </plan>
          <__nova_operations>
            <update_participant_plan>
              <case xmlns="http://commcarehq.org/case/transaction/v2" case_id="" date_modified="" user_id="">
                <update>
                  <main_crop/>
                </update>
              </case>
            </update_participant_plan>
          </__nova_operations>
          <deliver xmlns="http://commcareconnect.com/data/v1/learn" id="farm_plan">
            <name/>
            <entity_id/>
            <entity_name/>
          </deliver>
          <orx:meta xmlns:cc="http://commcarehq.org/xforms">
            <orx:instanceID/>
            <orx:timeEnd/>
          </orx:meta>
        </data>
      </instance>
      <instance id="commcaresession" src="jr://instance/session"/>
      <bind nodeset="/data/plan/main_crop" type="xsd:string" required="true()"/>
      <bind nodeset="/data/plan/planted_area_acres" type="xsd:decimal"/>
      <bind nodeset="/data/__nova_operations/update_participant_plan/case/@case_id" calculate="instance('commcaresession')/session/data/case_id"/>
      <bind nodeset="/data/__nova_operations/update_participant_plan/case/update/main_crop" calculate="/data/plan/main_crop"/>
    </model>
  </h:head>
  <h:body/>
</h:html>
