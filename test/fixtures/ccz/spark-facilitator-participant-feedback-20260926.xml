<h:html xmlns:h="http://www.w3.org/1999/xhtml" xmlns:orx="http://openrosa.org/jr/xforms" xmlns="http://www.w3.org/2002/xforms" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:jr="http://openrosa.org/javarosa" xmlns:vellum="http://commcarehq.org/xforms/vellum">
  <h:head>
    <h:title>Participant Feedback</h:title>
    <model>
      <instance>
        <data xmlns="http://openrosa.org/formdesigner/df9ebabd1b6704de" xmlns:jrm="http://dev.commcarehq.org/jr/xforms" uiVersion="1" version="9" name="participant_feedback">
          <before_you_start>
            <already_done_warning/>
            <feedback_intro/>
          </before_you_start>
          <people_to_ask/>
          <participants jr:template="">
            <consent>
              <feedback_script/>
              <feedback_consent/>
            </consent>
            <about_the_meetings>
              <participant_gender/>
              <attended_last_meeting/>
              <can_name_decision/>
              <decision_named/>
              <spoke_this_month/>
            </about_the_meetings>
            <recommendation>
              <nps/>
              <nps_probe/>
            </recommendation>
          </participants>
          <__nova_count_participants/>
          <feedback_end/>
          <participant_count/>
          <feedback_done_value/>
          <feedback_date_value/>
          <case xmlns="http://commcarehq.org/case/transaction/v2" case_id="" date_modified="" user_id="">
            <update>
              <feedback_date/>
              <feedback_done/>
            </update>
          </case>
          <orx:meta xmlns:cc="http://commcarehq.org/xforms">
            <orx:deviceID/>
            <orx:timeStart/>
            <orx:timeEnd/>
            <orx:username/>
            <orx:userID/>
            <orx:instanceID/>
            <cc:appVersion/>
            <orx:drift/>
            <cc:location/>
          </orx:meta>
        </data>
      </instance>
      <instance src="jr://instance/casedb" id="casedb"/>
      <instance src="jr://instance/session" id="commcaresession"/>
      <bind nodeset="/data/before_you_start/already_done_warning" relevant="instance('casedb')/casedb/case[@case_id = instance('commcaresession')/session/data/case_id]/feedback_done = 'yes'"/>
      <bind nodeset="/data/before_you_start/feedback_intro"/>
      <bind nodeset="/data/people_to_ask" type="xsd:int" required="true()" constraint=". &gt;= 1 and . &lt;= 8" jr:constraintMsg="jr:itext('people_to_ask-constraintMsg')"/>
      <bind nodeset="/data/participants/consent/feedback_script"/>
      <bind nodeset="/data/participants/consent/feedback_consent" type="xsd:string" required="true()"/>
      <bind nodeset="/data/participants/about_the_meetings" relevant="/data/participants/consent/feedback_consent = 'yes'"/>
      <bind nodeset="/data/participants/about_the_meetings/participant_gender" type="xsd:string" required="true()"/>
      <bind nodeset="/data/participants/about_the_meetings/attended_last_meeting" type="xsd:string" required="true()"/>
      <bind nodeset="/data/participants/about_the_meetings/can_name_decision" type="xsd:string" required="true()"/>
      <bind nodeset="/data/participants/about_the_meetings/decision_named" type="xsd:string" required="true()" constraint="string-length(.) &lt;= 100" jr:constraintMsg="jr:itext('participants-about_the_meetings-decision_named-constraintMsg')" relevant="/data/participants/about_the_meetings/can_name_decision = 'named'"/>
      <bind nodeset="/data/participants/about_the_meetings/spoke_this_month" type="xsd:string" required="true()"/>
      <bind nodeset="/data/participants/recommendation" relevant="/data/participants/consent/feedback_consent = 'yes'"/>
      <bind nodeset="/data/participants/recommendation/nps" type="xsd:int" required="true()" constraint=". &gt;= 0 and . &lt;= 10" jr:constraintMsg="jr:itext('participants-recommendation-nps-constraintMsg')"/>
      <bind nodeset="/data/participants/recommendation/nps_probe" type="xsd:string" constraint="string-length(.) &lt;= 200" jr:constraintMsg="jr:itext('participants-recommendation-nps_probe-constraintMsg')"/>
      <bind nodeset="/data/__nova_count_participants" type="xsd:string"/>
      <bind nodeset="/data/feedback_end"/>
      <bind nodeset="/data/participant_count" type="xsd:string" calculate="count(/data/participants)"/>
      <bind nodeset="/data/feedback_done_value" type="xsd:string" calculate="if(count(/data/participants) &gt;= 1, 'yes', 'no')"/>
      <bind nodeset="/data/feedback_date_value" type="xsd:string" calculate="today()"/>
      <setvalue event="xforms-ready" ref="/data/__nova_count_participants" value="string(/data/people_to_ask)"/>
      <itext>
        <translation lang="en" default="">
          <text id="before_you_start-label">
            <value>Before you start</value>
            <value form="markdown">Before you start</value>
          </text>
          <text id="before_you_start-already_done_warning-label">
            <value>A feedback round was already recorded for this community. Only continue if your supervisor asked you to.</value>
            <value form="markdown">A feedback round was already recorded for this community. Only continue if your supervisor asked you to.</value>
          </text>
          <text id="before_you_start-feedback_intro-label">
            <value>Read the questions aloud in the local language to 8 people who attended: 4 women and 4 men. Do not write any names or phone numbers.</value>
            <value form="markdown">Read the questions aloud in the local language to 8 people who attended: 4 women and 4 men. Do not write any names or phone numbers.</value>
          </text>
          <text id="people_to_ask-label">
            <value>How many people will you ask? Ask 8: 4 women and 4 men.</value>
            <value form="markdown">How many people will you ask? Ask 8: 4 women and 4 men.</value>
          </text>
          <text id="people_to_ask-constraintMsg">
            <value>Enter a number from 1 to 8.</value>
            <value form="markdown">Enter a number from 1 to 8.</value>
          </text>
          <text id="participants-label">
            <value>Person</value>
            <value form="markdown">Person</value>
          </text>
          <text id="participants-consent-label">
            <value>Consent</value>
            <value form="markdown">Consent</value>
          </text>
          <text id="participants-consent-feedback_script-label">
            <value>We are asking a few people about the community meetings, to learn whether the meetings share information well. Your answers go to the implementing organisation and to Spark MicroGrants. Supervisors read them; they are not used to pay or judge anyone. Your answers are not linked to your name. Answering is your choice, and you can stop at any time, even after we start. Answering gives you no payment or benefit, and saying no costs you nothing. Would you like to answer?</value>
            <value form="markdown">We are asking a few people about the community meetings, to learn whether the meetings share information well. Your answers go to the implementing organisation and to Spark MicroGrants. Supervisors read them; they are not used to pay or judge anyone. Your answers are not linked to your name. Answering is your choice, and you can stop at any time, even after we start. Answering gives you no payment or benefit, and saying no costs you nothing. Would you like to answer?</value>
          </text>
          <text id="participants-consent-feedback_consent-label">
            <value>Does this person agree to answer?</value>
            <value form="markdown">Does this person agree to answer?</value>
          </text>
          <text id="participants-about_the_meetings-label">
            <value>About the meetings</value>
            <value form="markdown">About the meetings</value>
          </text>
          <text id="participants-about_the_meetings-participant_gender-label">
            <value>Gender, as the person states it</value>
            <value form="markdown">Gender, as the person states it</value>
          </text>
          <text id="participants-about_the_meetings-participant_gender-opt0-label">
            <value>Female</value>
            <value form="markdown">Female</value>
          </text>
          <text id="participants-about_the_meetings-participant_gender-opt1-label">
            <value>Male</value>
            <value form="markdown">Male</value>
          </text>
          <text id="participants-about_the_meetings-attended_last_meeting-label">
            <value>Did you attend the last community meeting?</value>
            <value form="markdown">Did you attend the last community meeting?</value>
          </text>
          <text id="participants-about_the_meetings-attended_last_meeting-opt0-label">
            <value>Yes</value>
            <value form="markdown">Yes</value>
          </text>
          <text id="participants-about_the_meetings-attended_last_meeting-opt1-label">
            <value>No</value>
            <value form="markdown">No</value>
          </text>
          <text id="participants-about_the_meetings-can_name_decision-label">
            <value>Can you tell me one thing your community decided or agreed at a recent meeting?</value>
            <value form="markdown">Can you tell me one thing your community decided or agreed at a recent meeting?</value>
          </text>
          <text id="participants-about_the_meetings-can_name_decision-opt0-label">
            <value>Named a decision</value>
            <value form="markdown">Named a decision</value>
          </text>
          <text id="participants-about_the_meetings-can_name_decision-opt1-label">
            <value>Could not name one</value>
            <value form="markdown">Could not name one</value>
          </text>
          <text id="participants-about_the_meetings-decision_named-label">
            <value>What decision did they name?</value>
            <value form="markdown">What decision did they name?</value>
          </text>
          <text id="participants-about_the_meetings-decision_named-constraintMsg">
            <value>Use 100 characters or fewer.</value>
            <value form="markdown">Use 100 characters or fewer.</value>
          </text>
          <text id="participants-about_the_meetings-spoke_this_month-label">
            <value>Did you speak at a community meeting this month?</value>
            <value form="markdown">Did you speak at a community meeting this month?</value>
          </text>
          <text id="participants-about_the_meetings-spoke_this_month-opt2-label">
            <value>Not sure</value>
            <value form="markdown">Not sure</value>
          </text>
          <text id="participants-recommendation-label">
            <value>Recommendation</value>
            <value form="markdown">Recommendation</value>
          </text>
          <text id="participants-recommendation-nps-label">
            <value>On a scale from 0 to 10, how likely are you to recommend FCAP to another community?</value>
            <value form="markdown">On a scale from 0 to 10, how likely are you to recommend FCAP to another community?</value>
          </text>
          <text id="participants-recommendation-nps-constraintMsg">
            <value>Enter a number from 0 to 10.</value>
            <value form="markdown">Enter a number from 0 to 10.</value>
          </text>
          <text id="participants-recommendation-nps_probe-label">
            <value>What is the main reason for the score you gave?</value>
            <value form="markdown">What is the main reason for the score you gave?</value>
          </text>
          <text id="participants-recommendation-nps_probe-constraintMsg">
            <value>Use 200 characters or fewer.</value>
            <value form="markdown">Use 200 characters or fewer.</value>
          </text>
          <text id="feedback_end-label">
            <value>Thank you. Submit when you have asked all 8 people.</value>
            <value form="markdown">Thank you. Submit when you have asked all 8 people.</value>
          </text>
        </translation>
