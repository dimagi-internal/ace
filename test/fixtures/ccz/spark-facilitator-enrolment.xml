      <bind nodeset="/data/community_location/lon" type="xsd:string" calculate="if(/data/community_location/gps_coordinates_of_the_community = '', '', selected-at(/data/community_location/gps_coordinates_of_the_community, 1))"/>
      <bind nodeset="/data/community_location/gps_accuracy_good" relevant="(/data/community_location/gps_accuracy_m &gt;= 0 and /data/community_location/gps_accuracy_m &lt;= 15)"/>
      <bind nodeset="/data/community_location/gps_accuracy_usable" relevant="(/data/community_location/gps_accuracy_m &gt; 15 and /data/community_location/gps_accuracy_m &lt;= 50)"/>
      <bind nodeset="/data/community_location/gps_accuracy_imprecise" relevant="(/data/community_location/gps_accuracy_m &gt; 50)"/>
      <bind nodeset="/data/starting_step/starting_fcap_step" type="xsd:string" required="true()"/>
      <bind nodeset="/data/starting_step/meetings_on_current_step" type="xsd:string"/>
      <bind nodeset="/data/enrol_a_community_community_enrolment"/>
      <setvalue event="xforms-ready" ref="/data/starting_step/meetings_on_current_step" value="0"/>
