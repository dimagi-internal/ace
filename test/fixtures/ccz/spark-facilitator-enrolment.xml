      <bind nodeset="/data/case/@date_modified" type="xsd:dateTime" calculate="/data/meta/timeEnd"/>
      <bind nodeset="/data/case/@user_id" calculate="/data/meta/userID"/>
      <setvalue ref="/data/case/@case_id" value="instance('commcaresession')/session/data/case_id_new_village_0" event="xforms-ready"/>
      <bind nodeset="/data/case/create/case_name" calculate="/data/community_identity/village_name"/>
      <bind nodeset="/data/case/create/owner_id" calculate="/data/meta/userID"/>
      <bind nodeset="/data/case/update/community_unique_identifier" calculate="/data/community_identity/community_unique_identifier" relevant="count(/data/community_identity/community_unique_identifier) &gt; 0"/>
      <bind nodeset="/data/case/update/district" calculate="/data/community_identity/district" relevant="count(/data/community_identity/district) &gt; 0"/>
      <bind nodeset="/data/case/update/gps_coordinates_of_the_community" calculate="/data/community_location/gps_coordinates_of_the_community" relevant="count(/data/community_location/gps_coordinates_of_the_community) &gt; 0"/>
      <bind nodeset="/data/case/update/group_village" calculate="/data/community_identity/group_village" relevant="count(/data/community_identity/group_village) &gt; 0"/>
      <bind nodeset="/data/case/update/household_count" calculate="/data/households/household_count" relevant="count(/data/households/household_count) &gt; 0"/>
      <bind nodeset="/data/case/update/meetings_on_current_step" calculate="/data/starting_step/meetings_on_current_step" relevant="count(/data/starting_step/meetings_on_current_step) &gt; 0"/>
      <bind nodeset="/data/case/update/partner" calculate="/data/community_identity/partner" relevant="count(/data/community_identity/partner) &gt; 0"/>
      <bind nodeset="/data/case/update/pilot_fcap_step" calculate="/data/starting_step/starting_fcap_step" relevant="count(/data/starting_step/starting_fcap_step) &gt; 0"/>
      <bind nodeset="/data/case/update/traditional_authority" calculate="/data/community_identity/traditional_authority" relevant="count(/data/community_identity/traditional_authority) &gt; 0"/>
      <setvalue ref="/data/meta/deviceID" value="instance('commcaresession')/session/context/deviceid" event="xforms-ready"/>
      <setvalue ref="/data/meta/timeStart" value="now()" event="xforms-ready"/>
      <bind nodeset="/data/meta/timeStart" type="xsd:dateTime"/>
      <setvalue ref="/data/meta/timeEnd" value="now()" event="xforms-revalidate"/>
      <bind nodeset="/data/meta/timeEnd" type="xsd:dateTime"/>
      <setvalue ref="/data/meta/username" value="instance('commcaresession')/session/context/username" event="xforms-ready"/>
      <setvalue ref="/data/meta/userID" value="instance('commcaresession')/session/context/userid" event="xforms-ready"/>
      <setvalue ref="/data/meta/instanceID" value="uuid()" event="xforms-ready"/>
      <setvalue ref="/data/meta/appVersion" value="instance('commcaresession')/session/context/appversion" event="xforms-ready"/>
      <setvalue ref="/data/meta/drift" value="if(count(instance('commcaresession')/session/context/drift) = 1, instance('commcaresession')/session/context/drift, '')" event="xforms-revalidate"/>
      <orx:pollsensor event="xforms-ready" ref="/data/meta/location"/>
      <bind nodeset="/data/meta/location" type="geopoint"/>
    </model>
  </h:head>
  <h:body>
    <group ref="/data/community_identity" appearance="field-list">
      <label ref="jr:itext('community_identity-label')"/>
      <input ref="/data/community_identity/village_name">
        <label ref="jr:itext('community_identity-village_name-label')"/>
      </input>
      <input ref="/data/community_identity/group_village">
        <label ref="jr:itext('community_identity-group_village-label')"/>
      </input>
      <input ref="/data/community_identity/traditional_authority">
        <label ref="jr:itext('community_identity-traditional_authority-label')"/>
      </input>
      <input ref="/data/community_identity/district">
        <label ref="jr:itext('community_identity-district-label')"/>
      </input>
      <input ref="/data/community_identity/community_unique_identifier">
        <label ref="jr:itext('community_identity-community_unique_identifier-label')"/>
        <hint ref="jr:itext('community_identity-community_unique_identifier-hint')"/>
      </input>
      <input ref="/data/community_identity/partner">
        <label ref="jr:itext('community_identity-partner-label')"/>
      </input>
    </group>
    <group ref="/data/households" appearance="field-list">
      <label ref="jr:itext('households-label')"/>
      <input ref="/data/households/household_count">
        <label ref="jr:itext('households-household_count-label')"/>
        <hint ref="jr:itext('households-household_count-hint')"/>
      </input>
    </group>
    <group ref="/data/community_location" appearance="field-list">
      <label ref="jr:itext('community_location-label')"/>
      <input ref="/data/community_location/gps_coordinates_of_the_community">
        <label ref="jr:itext('community_location-gps_coordinates_of_the_community-label')"/>
        <hint ref="jr:itext('community_location-gps_coordinates_of_the_community-hint')"/>
      </input>
      <trigger ref="/data/community_location/gps_accuracy_good" appearance="minimal">
        <label ref="jr:itext('community_location-gps_accuracy_good-label')"/>
      </trigger>
      <trigger ref="/data/community_location/gps_accuracy_usable" appearance="minimal">
        <label ref="jr:itext('community_location-gps_accuracy_usable-label')"/>
      </trigger>
      <trigger ref="/data/community_location/gps_accuracy_imprecise" appearance="minimal">
        <label ref="jr:itext('community_location-gps_accuracy_imprecise-label')"/>
      </trigger>
    </group>
    <group ref="/data/starting_step" appearance="field-list">
      <label ref="jr:itext('starting_step-label')"/>
      <select1 ref="/data/starting_step/starting_fcap_step">
        <label ref="jr:itext('starting_step-starting_fcap_step-label')"/>
        <hint ref="jr:itext('starting_step-starting_fcap_step-hint')"/>
        <item>
          <label ref="jr:itext('starting_step-starting_fcap_step-opt0-label')"/>
          <value>step_1</value>
        </item>
        <item>
          <label ref="jr:itext('starting_step-starting_fcap_step-opt1-label')"/>
          <value>step_2</value>
        </item>
        <item>
          <label ref="jr:itext('starting_step-starting_fcap_step-opt2-label')"/>
          <value>step_3</value>
        </item>
        <item>
          <label ref="jr:itext('starting_step-starting_fcap_step-opt3-label')"/>
          <value>step_4</value>
        </item>
        <item>
          <label ref="jr:itext('starting_step-starting_fcap_step-opt4-label')"/>
          <value>step_5</value>
        </item>
        <item>
          <label ref="jr:itext('starting_step-starting_fcap_step-opt5-label')"/>
          <value>step_6</value>
        </item>
        <item>
          <label ref="jr:itext('starting_step-starting_fcap_step-opt6-label')"/>
          <value>step_7</value>
        </item>
      </select1>
    </group>
  </h:body>
</h:html>