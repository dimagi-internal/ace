      <bind nodeset="/data/community_location/gps_accuracy_m" type="xsd:string" calculate="if(/data/community_location/gps_coordinates_of_the_community = '', -1, number(selected-at(/data/community_location/gps_coordinates_of_the_community, 3)))"/>
