          <enrol_a_community_community_enrolment>
            <task xmlns="http://commcareconnect.com/data/v1/learn" id="enrol_a_community_community_enrolment">
              <name>Enrol a community</name>
              <description>Open the record for an FCAP community before its meetings can be recorded. Filed once per community and not paid.</description>
            </task>
          </enrol_a_community_community_enrolment>
          <case xmlns="http://commcarehq.org/case/transaction/v2" case_id="" date_modified="" user_id="">
            <create>
              <case_name/>
              <owner_id/>
              <case_type>village</case_type>
            </create>
            <update>
              <community_unique_identifier/>
              <district/>
              <gps_coordinates_of_the_community/>
              <group_village/>
              <household_count/>
              <meetings_on_current_step/>
              <partner/>
              <pilot_fcap_step/>
              <traditional_authority/>
            </update>
          </case>
          <orx:meta xmlns:cc="http://commcarehq.org/xforms">
            <orx:deviceID/>
            <orx:timeStart/>
            <orx:timeEnd/>
            <orx:username/>
            <orx:userID/>
            <orx:instanceID/>
            <cc:appVersion/>
            <orx:drift/>
            <cc:location/>
          </orx:meta>
        </data>
      </instance>
      <instance id="commcaresession" src="jr://instance/session"/>
      <bind nodeset="/data/community_identity/village_name" type="xsd:string" required="true()" constraint="string-length(.) &lt;= 80" jr:constraintMsg="jr:itext('community_identity-village_name-constraintMsg')"/>
      <bind nodeset="/data/community_identity/group_village" type="xsd:string" constraint="string-length(.) &lt;= 80" jr:constraintMsg="jr:itext('community_identity-district-constraintMsg')"/>
      <bind nodeset="/data/community_identity/traditional_authority" type="xsd:string" constraint="string-length(.) &lt;= 80" jr:constraintMsg="jr:itext('community_identity-district-constraintMsg')"/>
      <bind nodeset="/data/community_identity/district" type="xsd:string" constraint="string-length(.) &lt;= 80" jr:constraintMsg="jr:itext('community_identity-district-constraintMsg')"/>
      <bind nodeset="/data/community_identity/community_unique_identifier" type="xsd:string" required="true()" constraint="string-length(.) &lt;= 40" jr:constraintMsg="jr:itext('community_identity-community_unique_identifier-constraintMsg')"/>
      <bind nodeset="/data/community_identity/partner" type="xsd:string" constraint="string-length(.) &lt;= 80" jr:constraintMsg="jr:itext('community_identity-district-constraintMsg')"/>
