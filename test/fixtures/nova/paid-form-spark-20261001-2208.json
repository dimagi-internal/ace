     "kind": "group",
     "children": [
      {
       "uuid": "e4e2eebb-02a3-48f4-afc4-631cd79f9dec",
       "id": "photo_consent_script",
       "label": "Read this aloud to the group before you take the photo:\n\nI will take one photo of this meeting. The photo shows that the meeting happened. The photo and this meeting record go to the implementing organisation, Spark MicroGrants and Dimagi, through Connect, the system that pays me. Supervisors at the implementing organisation look at the photos to confirm that meetings happened.\n\nNo names are attached to the photo. The photo is not shared publicly.\n\nBeing in the photo is your choice. If you do not want to be in it, you can sit to one side. You can also ask me, now or later, to leave you out.\n\nBeing in the photo gives you no payment or benefit. Staying out costs you nothing: you are still counted as attending.",
       "kind": "label"
      },
      {
       "uuid": "6c1e77cf-2f8b-4f6e-993b-c450a0879cb3",
       "id": "photo_statement_read",
       "label": "Did you read this statement aloud to the group?",
       "required": "true()",
       "kind": "single_select",
       "optionsSource": {
        "kind": "inline",
        "options": [
         {
          "optionUuid": "763f07a5-8662-4a09-98ec-988ea34f8b2f",
          "value": "yes",
          "label": "Yes, I read it and left out anyone who asked"
         },
         {
          "optionUuid": "90b114e0-8043-4981-85ec-145cf32b47d7",
          "value": "no",
          "label": "No"
         }
        ]
       },
       "validate": {
        "expr": ". = 'yes'",
        "msg": "Read the statement aloud to the group first, then answer Yes."
       },
       "initialValue": {
        "source": "blank"
       }
      }
